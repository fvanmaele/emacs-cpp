+      markIndexed(Path, ReindexFailed);
+      return;
+    }
+    markIndexed(Path, *Number);
   });
   T.QueuePri = IndexFile;
   T.ThreadPri = IndexingPriority;
@@ -311,8 +320,10 @@ void BackgroundIndex::update(
     }
     HeaderAndTU.emplace_back(*AbsPath, MainFile.str());
     const auto DigestIt = ShardVersionsSnapshot.find(*AbsPath);
-    // File has different contents, or indexing was successful this time.
-    if (DigestIt == ShardVersionsSnapshot.end() ||
+    // File has different contents, or indexing was successful this time. The
+    // main file's shard is always rewritten: its references depend on the
+    // headers it includes, which may have changed while it did not.
+    if (*AbsPath == MainFile || DigestIt == ShardVersionsSnapshot.end() ||
         DigestIt->getValue().Digest != IGN.Digest ||
         (DigestIt->getValue().HadErrors && !HadErrors))
       FilesToUpdate[IGN.URI] = {std::move(*AbsPath), IGN.Digest};
@@ -365,7 +376,8 @@ void BackgroundIndex::update(
   }
 }
 
-llvm::Error BackgroundIndex::index(tooling::CompileCommand Cmd) {
+llvm::Expected<unsigned>
+BackgroundIndex::index(tooling::CompileCommand Cmd) {
   trace::Span Tracer("BackgroundIndex");
   SPAN_ATTACH(Tracer, "file", Cmd.Filename);
   auto AbsolutePath = getAbsolutePath(Cmd);
@@ -403,6 +415,10 @@ llvm::Error BackgroundIndex::index(tooling::CompileCommand Cmd) {
   // digests.
   IndexOpts.FileFilter = [&ShardVersionsSnapshot](const SourceManager &SM,
                                                   FileID FID) {
+    // The main file is always collected: its shard is rewritten by every
+    // reindex (update()), as its references depend on the headers too.
+    if (FID == SM.getMainFileID())
+      return true;
     const auto F = SM.getFileEntryRefForID(FID);
     if (!F)
       return false; // Skip invalid files.
@@ -457,8 +473,7 @@ llvm::Error BackgroundIndex::index(tooling::CompileCommand Cmd) {
   }
   update(AbsolutePath, std::move(Index), ShardVersionsSnapshot, HadErrors);
 
-  Rebuilder.indexedTU();
-  return llvm::Error::success();
+  return Rebuilder.indexedTU();
 }
 
 // A shard load is counted from enqueue() until loadProject() has recorded the
@@ -558,23 +573,25 @@ BackgroundIndex::loadProject(std::vector<std::string> MainFiles) {
   }
   Rebuilder.loadedShard(LoadedShards);
   Rebuilder.doneLoading();
-  // The index now holds these shards (doneLoading() rebuilds it in this
-  // thread): navigation from the index may answer (waitForLoadedShards).
-  {
-    std::lock_guard<std::mutex> Lock(IncludersMu);
-    --ShardsLoading;
-  }
-  IncludersChanged.notify_all();
 
-  auto FS = TFS.view(/*CWD=*/std::nullopt);
+  // Navigation from the index waits for this check (the stale TUs are
+  // marked below before it may answer), so the files are read in parallel:
+  // reading one is mostly waiting (an on-access scanner: 2661 files of a
+  // deal.II TU 3.9 s one by one, 0.7 s eight at a time).
+  std::vector<char> StaleShards(Result.size());
+  llvm::parallelFor(0, Result.size(), [&](size_t I) {
+    StaleShards[I] =
+        shardIsStale(Result[I], TFS.view(/*CWD=*/std::nullopt).get());
+  });
   llvm::DenseSet<PathRef> TUsToIndex;
   // We'll accept data from stale shards, but ensure the files get reindexed
   // soon. Shards indexed with errors are reindexed too: the errors may be
   // gone without any file in the shard's include graph changing (a header
   // that did not exist then is not in it, a fixed header reindexes only one
   // of its includers), and a flagged shard may lack symbols and references.
-  for (auto &LS : Result) {
-    bool Stale = shardIsStale(LS, FS.get());
+  for (size_t I = 0; I < Result.size(); ++I) {
+    const LoadedShard &LS = Result[I];
+    bool Stale = StaleShards[I];
     if (!Stale && !LS.HadErrors)
       continue;
     PathRef TUForFile = LS.DependentTU;
@@ -591,7 +608,51 @@ BackgroundIndex::loadProject(std::vector<std::string> MainFiles) {
     TUsToIndex.insert(TUForFile);
   }
 
-  return {TUsToIndex.begin(), TUsToIndex.end()};
+  // Marked before navigation from the index may answer: a stale TU's shard
+  // must not answer until its reindex is served.
+  auto Queued = markQueued({TUsToIndex.begin(), TUsToIndex.end()});
+  // The index now holds these shards (doneLoading() rebuilt it above):
+  // navigation from the index may answer (waitForLoadedShards).
+  {
+    std::lock_guard<std::mutex> Lock(IncludersMu);
+    --ShardsLoading;
+  }
+  IncludersChanged.notify_all();
+  return Queued;
+}
+
+std::vector<std::string>
+BackgroundIndex::markQueued(std::vector<std::string> MainFiles) {
+  std::lock_guard<std::mutex> Lock(ReindexingMu);
+  llvm::erase_if(MainFiles, [&](const std::string &File) {
+    return !QueuedOnce.insert(File).second;
+  });
+  for (const auto &File : MainFiles)
+    Reindexing[File] = 0;
+  return MainFiles;
+}
+
+void BackgroundIndex::markIndexed(PathRef MainFile, unsigned Number) {
+  std::lock_guard<std::mutex> Lock(ReindexingMu);
+  auto It = Reindexing.find(MainFile);
+  if (It != Reindexing.end())
+    It->second = Number;
+}
+
+llvm::StringRef BackgroundIndex::reindexPending(PathRef File) {
+  std::string Real = realDirectoryPath(File);
+  std::lock_guard<std::mutex> Lock(ReindexingMu);
+  auto It = Reindexing.find(Real);
+  if (It == Reindexing.end())
+    return "";
+  if (It->second == 0)
+    return "it is queued for reindexing or being indexed";
+  if (It->second == ReindexFailed)
+    return "its reindex failed";
+  if (Rebuilder.servedTUs() < It->second)
+    return "its reindex is not in the served index yet";
+  Reindexing.erase(It);
+  return "";
 }
 
