-  llvm::Error index(tooling::CompileCommand);
+  // The TU's number from the rebuilder, or ReindexFailed's error.
+  llvm::Expected<unsigned> index(tooling::CompileCommand);
 
   FileSymbols IndexedSymbols;
   BackgroundIndexRebuilder Rebuilder;
@@ -263,6 +271,18 @@ private:
   unsigned ShardsLoading = 0;
   std::mutex IncludersMu;
   std::condition_variable IncludersChanged;
+  // Main files (real directory path) queued for indexing -> 0 while queued or
+  // being indexed, then the TU's number from the rebuilder (served once
