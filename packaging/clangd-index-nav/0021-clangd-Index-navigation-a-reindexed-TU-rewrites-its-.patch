@@ -933,6 +933,16 @@ ClangdServer::navigationShard(PathRef File,
            File);
       return std::nullopt;
     }
+    // A file it includes may have changed since its shard was stored; the
+    // stored shards are checked for that when they load (before
+    // waitForNavigationIndex returns), so wait for that first.
+    if (!waitForNavigationIndex(Answered, "Navigation", File))
+      return std::nullopt;
+    llvm::StringRef Why = BackgroundIdx->reindexPending(File);
+    if (!Why.empty()) {
+      vlog("Navigation in {0} needs the AST: {1}", File, Why);
+      return std::nullopt;
+    }
   } else {
     // A header is parsed with the flags of a source file that includes it;
     // its shard holds the #ifdef branches of the command it was indexed with.
