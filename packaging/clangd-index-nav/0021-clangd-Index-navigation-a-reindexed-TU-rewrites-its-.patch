@@ -200,13 +202,20 @@ BackgroundQueue::Task BackgroundIndex::indexFileTask(std::string Path) {
     if (ContextProvider)
       WithProvidedContext.emplace(ContextProvider(Path));
     auto Cmd = CDB.getCompileCommand(Path);
-    if (!Cmd)
+    if (!Cmd) {
+      markIndexed(Path, ReindexFailed);
       return;
+    }
