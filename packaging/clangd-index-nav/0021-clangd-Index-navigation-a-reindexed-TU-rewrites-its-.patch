+  llvm::StringMap<unsigned> Reindexing;
+  // Main files ever handed to the queue: it drops a second task of a file
+  // (BackgroundQueue::Task::Key), so those are not marked again.
+  llvm::StringSet<> QueuedOnce;
+  std::mutex ReindexingMu;
+  static constexpr unsigned ReindexFailed = ~0u;
+  // Marks \p MainFiles as queued; returns those the queue will accept.
+  std::vector<std::string> markQueued(std::vector<std::string> MainFiles);
+  void markIndexed(PathRef MainFile, unsigned Number);
   void recordIncluders(llvm::ArrayRef<std::pair<std::string, std::string>>
                            HeaderAndTU);
 
diff --git a/clang-tools-extra/clangd/index/BackgroundRebuild.cpp b/clang-tools-extra/clangd/index/BackgroundRebuild.cpp
