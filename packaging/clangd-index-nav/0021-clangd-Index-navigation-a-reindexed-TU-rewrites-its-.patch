+TEST(NavigationFromShard, StaleTUWaitsForItsServedReindex) {
+  // S23 case 1a: a header changed on disk while clangd was not running, the
+  // main file did not. The main file's stored shard still passes its own
+  // digest check, but its references were resolved against the old header.
+  MockFS FS;
+  llvm::StringMap<std::string> Storage;
+  size_t CacheHits = 0;
+  MemoryShardStorage MSS(Storage, CacheHits);
+  std::string MainPath = testPath("root/A.cc");
+  std::string HeaderPath = testPath("root/foo.h");
+  FS.Files[HeaderPath] = "int foo(int);";
+  FS.Files[MainPath] = "#include \"foo.h\"\nint y = foo(1);";
+  tooling::CompileCommand Cmd;
+  Cmd.Filename = MainPath;
+  Cmd.Directory = testPath("root");
+  Cmd.CommandLine = {"clang++", MainPath};
+  {
+    OverlayCDB CDB(/*Base=*/nullptr);
+    BackgroundIndex Idx(FS, CDB, [&](llvm::StringRef) { return &MSS; },
+                        BackgroundIndex::Options{});
+    CDB.setCompileCommand(MainPath, Cmd);
+    ASSERT_TRUE(Idx.blockUntilIdleForTest());
+  }
+  // foo(1) now calls foo(double), another symbol.
+  FS.Files[HeaderPath] = "int foo(double);";
+
+  // The second session: hold the reindex of A.cc (the second context asked
+  // for A.cc; the first is the shard load's).
+  std::mutex Mu;
+  std::condition_variable CV;
+  bool Release = false;
+  unsigned MainContexts = 0;
+  BackgroundIndex::Options Opts;
+  Opts.ContextProvider = [&](PathRef P) {
+    if (P == MainPath) {
+      std::unique_lock<std::mutex> Lock(Mu);
+      if (++MainContexts == 2)
+        CV.wait(Lock, [&] { return Release; });
+    }
+    return Context::current().clone();
+  };
+  OverlayCDB CDB(/*Base=*/nullptr);
+  BackgroundIndex Idx(FS, CDB, [&](llvm::StringRef) { return &MSS; }, Opts);
+  CDB.setCompileCommand(MainPath, Cmd);
+  auto Never = [] { return false; };
+  ASSERT_TRUE(Idx.waitForLoadedShards(
+      std::chrono::steady_clock::now() + std::chrono::seconds(10), Never));
+  EXPECT_EQ(Idx.reindexPending(MainPath),
+            "it is queued for reindexing or being indexed");
+  {
+    std::lock_guard<std::mutex> Lock(Mu);
+    Release = true;
+  }
+  CV.notify_all();
+  ASSERT_TRUE(Idx.blockUntilIdleForTest());
+  // The rebuild after the queue empties serves the reindex.
+  auto Until = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (!Idx.reindexPending(MainPath).empty() &&
+         std::chrono::steady_clock::now() < Until)
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  EXPECT_EQ(Idx.reindexPending(MainPath), "");
+
+  // The reindex rewrote A.cc's shard although only foo.h changed: its
+  // reference at foo(1) is to foo(double).
+  auto HeaderShard = MSS.loadShard(HeaderPath);
+  auto MainShard = MSS.loadShard(MainPath);
+  ASSERT_TRUE(HeaderShard && HeaderShard->Symbols && MainShard &&
+              MainShard->Refs);
+  std::optional<SymbolID> FooDouble;
+  for (const Symbol &S : *HeaderShard->Symbols)
+    if (S.Name == "foo")
+      FooDouble = S.ID;
+  ASSERT_TRUE(FooDouble);
+  bool RefersToFooDouble = false;
+  for (const auto &[ID, Refs] : *MainShard->Refs)
+    if (ID == *FooDouble)
+      RefersToFooDouble = true;
+  EXPECT_TRUE(RefersToFooDouble);
+  // A file never queued has nothing pending.
+  EXPECT_EQ(Idx.reindexPending(testPath("root/B.cc")), "");
+}
+
 TEST(NavigationFromShard, MethodReferencesNeedTheAST) {
   // References of a method that may be virtual include its overrides and the
   // methods it overrides (the AST path); the index cannot tell, so it does not
@@ -1595,6 +1677,23 @@ TEST_F(BackgroundIndexRebuilderTest, IndexingTUs) {
   EXPECT_TRUE(checkRebuild([&] { Rebuilder.indexedTU(); }));
 }
 
+TEST_F(BackgroundIndexRebuilderTest, ServedTUsFollowTheServedVersion) {
+  EXPECT_EQ(Rebuilder.servedTUs(), 0u);
+  unsigned Last = 0;
+  for (unsigned I = 0; I < Rebuilder.TUsBeforeFirstBuild - 1; ++I) {
+    unsigned Number = Rebuilder.indexedTU();
+    EXPECT_EQ(Number, Last + 1);
+    Last = Number;
+    EXPECT_LT(Rebuilder.servedTUs(), Number);
+  }
+  Last = Rebuilder.indexedTU(); // builds the first version
+  EXPECT_EQ(Rebuilder.servedTUs(), Last);
+  unsigned Next = Rebuilder.indexedTU();
+  EXPECT_LT(Rebuilder.servedTUs(), Next);
+  Rebuilder.idle();
+  EXPECT_EQ(Rebuilder.servedTUs(), Next);
+}
+
