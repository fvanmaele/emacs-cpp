From 3113038d16999a9f3ef1187843581c0fa7b2a115 Mon Sep 17 00:00:00 2001
From: Ferdinand Vanmaele <info@fvanmaele.de>
Date: Sun, 22 Nov 2026 09:50:54 +0100
Subject: [PATCH 18/19] [clangd] Header flags from the index: real paths, and
 wait once per header

includerOf() looked headers up by the editor's spelling, while the index
names files by their directory's real path (patch 0010): a header opened
through a symbolic link (on macOS any project under /tmp) found no
includer. It now also looks under the real path.

A header with no known includer waited up to 5 s for the shards to load at
every call, and its compile command is asked for at every edit; a load that
stays counted (every index worker busy with a long file) stalled each edit
by the full wait. A header now waits only the first time it asks.
---
 clang-tools-extra/clangd/index/Background.cpp | 35 +++++++++++++++----
 clang-tools-extra/clangd/index/Background.h   |  9 +++--
 .../clangd/unittests/BackgroundIndexTests.cpp | 11 ++++++
 3 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/clang-tools-extra/clangd/index/Background.cpp b/clang-tools-extra/clangd/index/Background.cpp
index 1e49eac..c10dcd9 100644
--- a/clang-tools-extra/clangd/index/Background.cpp
+++ b/clang-tools-extra/clangd/index/Background.cpp
@@ -235,13 +235,37 @@ void BackgroundIndex::recordIncluders(
 std::optional<std::string>
 BackgroundIndex::includerOf(PathRef Header,
                             std::chrono::steady_clock::duration Wait) {
+  // The index names files by their directory's real path
+  // (namedByRealDirectory()); the editor may name the header through a
+  // symbolic link above it (on macOS, /tmp for /private/tmp).
+  std::string RealHeader = Header.str();
+  {
+    llvm::SmallString<256> Real;
+    if (!TFS.view(/*CWD=*/std::nullopt)
+             ->getRealPath(llvm::sys::path::parent_path(Header), Real)) {
+      llvm::sys::path::append(Real, llvm::sys::path::filename(Header));
+      RealHeader = std::string(Real.str());
+    }
+  }
+  auto Known = [&]() -> std::optional<std::string> {
+    auto It = Includers.find(Header);
+    if (It == Includers.end())
+      It = Includers.find(RealHeader);
+    if (It == Includers.end())
+      return std::nullopt;
+    return It->getValue();
+  };
   {
     // A known includer is the answer; waiting for the compile database below
     // would only stall while its broadcast thread announces another project.
+    // A header that has waited once does not wait again: its compile command
+    // is asked for at every edit, and a load that stays counted (every index
+    // worker busy with a long file) would stall each edit by the full wait.
     std::lock_guard<std::mutex> Lock(IncludersMu);
-    auto It = Includers.find(Header);
-    if (It != Includers.end())
-      return It->getValue();
+    if (auto Includer = Known())
+      return Includer;
+    if (!WaitedFor.insert(RealHeader).second)
+      return std::nullopt;
   }
   auto Until = std::chrono::steady_clock::now() + Wait;
   // The compile database hands a newly found project to the index on its own
@@ -252,10 +276,7 @@ BackgroundIndex::includerOf(PathRef Header,
   std::unique_lock<std::mutex> Lock(IncludersMu);
   IncludersChanged.wait_until(Lock, Until,
                               [&] { return ProjectsLoading == 0; });
-  auto It = Includers.find(Header);
-  if (It == Includers.end())
-    return std::nullopt;
-  return It->getValue();
+  return Known();
 }
 
 /// Given index results from a TU, only update symbols coming from files that
diff --git a/clang-tools-extra/clangd/index/Background.h b/clang-tools-extra/clangd/index/Background.h
index da2d7ce..433686b 100644
--- a/clang-tools-extra/clangd/index/Background.h
+++ b/clang-tools-extra/clangd/index/Background.h
@@ -23,6 +23,7 @@
 #include "clang/Tooling/CompilationDatabase.h"
 #include "llvm/ADT/STLFunctionalExtras.h"
 #include "llvm/ADT/StringMap.h"
+#include "llvm/ADT/StringSet.h"
 #include "llvm/Support/Threading.h"
 #include <atomic>
 #include <condition_variable>
@@ -172,8 +173,9 @@ public:
   /// this session. A known includer is returned at once. Otherwise waits up to
   /// \p Wait in total: first for the compile database to hand over the
   /// projects it has found (blockUntilIdle), then for their stored shards to
-  /// be read (not for the index built from them). std::nullopt if no source
-  /// file is known to include \p Header.
+  /// be read (not for the index built from them); only the first time a
+  /// header asks. \p Header may be named through a symbolic link above it.
+  /// std::nullopt if no source file is known to include \p Header.
   std::optional<std::string>
   includerOf(PathRef Header, std::chrono::steady_clock::duration Wait);
 
@@ -240,6 +242,9 @@ private:
 
   // Header -> a translation unit that includes it (see includerOf).
   llvm::StringMap<std::string> Includers;
+  // Headers (by real path) whose includerOf() has waited once; they do not
+  // wait again.
+  llvm::StringSet<> WaitedFor;
   // Number of enqueued shard loads (changedFilesTask) whose includers are not
   // recorded yet: counted by projectLoadStarted() in enqueue() and
   // projectLoadFinished() in loadProject(), the two defined side by side.
diff --git a/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp b/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
index 73df3fe..9be8a78 100644
--- a/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
+++ b/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
@@ -798,6 +798,10 @@ TEST_F(BackgroundIndexTest, MainFileThroughASymlink) {
       runFuzzyFind(Idx, ""),
       UnorderedElementsAre(AllOf(named("header_sym"), numReferences(1U)),
                            AllOf(named("main_sym"), numReferences(1U))));
+  // A header the editor names through the link finds its includer, which the
+  // index names by the real directory.
+  EXPECT_EQ(Idx.includerOf(Link + "/A.h", std::chrono::seconds(0)),
+            Real + "/A.cc");
   llvm::sys::fs::remove_directories(Root);
 }
 #endif
@@ -1073,6 +1077,13 @@ TEST_F(BackgroundIndexTest, IncluderOfKnownHeaderDoesNotWaitForTheDatabase) {
                               std::chrono::milliseconds(300)));
   EXPECT_GE(std::chrono::steady_clock::now() - Start,
             std::chrono::milliseconds(300));
+  // But only once: its command is asked for at every edit, and each would
+  // stall as long while the database stays busy.
+  Start = std::chrono::steady_clock::now();
+  EXPECT_FALSE(Idx.includerOf(testPath("root/inc/unused.h"),
+                              std::chrono::seconds(5)));
+  EXPECT_LT(std::chrono::steady_clock::now() - Start,
+            std::chrono::milliseconds(200));
   CDB.Busy = false;
 }
 
