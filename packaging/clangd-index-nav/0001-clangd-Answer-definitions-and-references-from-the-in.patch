diff --git a/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp b/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
index 0eb4acf04..7cfd1f86b 100644
--- a/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
+++ b/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
@@ -5,6 +5,7 @@
 #include "SyncAPI.h"
 #include "TestFS.h"
 #include "TestTU.h"
+#include "XRefs.h"
 #include "index/Background.h"
 #include "index/BackgroundRebuild.h"
 #include "index/MemIndex.h"
@@ -162,6 +163,138 @@ TEST_F(BackgroundIndexTest, Config) {
                                    qName("bar"), qName("bar::one")));
 }
 
+// Navigation answered from a file's background-index shard instead of its AST
+// (ClangdServer::Options::NavigationFromIndex): where the shard answers, the
+// answers must equal the AST's; for edited content and positions the shard does
+// not record it must not answer.
+class NavigationFromShardTest : public BackgroundIndexTest {
+protected:
+  Annotations Header{R"cpp(
+    #pragma once
+    int $decl[[foo]]();
+    struct $bar[[Bar]] {};
+  )cpp"};
+  Annotations Main{R"cpp(
+    #include "foo.h"
+    int $def[[foo]]() { return 1; }
+    $kw^int main() {
+      $type^Bar b;
+      $auto^auto x = 2;
+      return $call^foo() + $use^x;
+    }
+  )cpp"};
+  std::string MainPath = testPath("root/A.cc");
+  MockFS FS;
+  llvm::StringMap<std::string> Storage;
+  size_t CacheHits = 0;
+  MemoryShardStorage MSS{Storage, CacheHits};
+  OverlayCDB CDB{/*Base=*/nullptr};
+  std::unique_ptr<BackgroundIndex> Idx;
+
+  void SetUp() override {
+    FS.Files[testPath("root/foo.h")] = Header.code();
+    FS.Files[MainPath] = Main.code();
+    Idx = std::make_unique<BackgroundIndex>(
+        FS, CDB, [&](llvm::StringRef) { return &MSS; }, /*Opts=*/
+        BackgroundIndex::Options{});
+    tooling::CompileCommand Cmd;
+    Cmd.Filename = MainPath;
+    Cmd.Directory = testPath("root");
+    Cmd.CommandLine = {"clang++", MainPath};
+    CDB.setCompileCommand(MainPath, Cmd);
+    ASSERT_TRUE(Idx->blockUntilIdleForTest());
+  }
+
+  ParsedAST buildAST() const {
+    TestTU TU;
+    TU.Filename = "root/A.cc";
+    TU.Code = Main.code().str();
+    TU.AdditionalFiles["root/foo.h"] = Header.code().str();
+    return TU.build();
+  }
+
+  static std::vector<std::tuple<std::string, Range, unsigned>>
+  sorted(const ReferencesResult &R) {
+    std::vector<std::tuple<std::string, Range, unsigned>> V;
+    for (const auto &Ref : R.References)
+      V.emplace_back(Ref.Loc.uri.file().str(), Ref.Loc.range, Ref.Attributes);
+    llvm::sort(V);
+    return V;
+  }
+};
+
+TEST_F(NavigationFromShardTest, DefinitionsMatchTheAST) {
+  auto Shard = Idx->loadShard(MainPath);
+  ASSERT_TRUE(Shard);
+  ParsedAST AST = buildAST();
+  for (llvm::StringRef Point : {"call", "type"}) {
+    SCOPED_TRACE(Point);
+    auto FromShard = locateSymbolFromShard(*Shard, MainPath, Main.code(),
+                                           Main.point(Point), Idx.get());
+    ASSERT_TRUE(FromShard);
+    auto FromAST = locateSymbolAt(AST, Main.point(Point), Idx.get());
+    ASSERT_EQ(FromShard->size(), 1u);
+    ASSERT_EQ(FromAST.size(), 1u);
+    EXPECT_EQ((*FromShard)[0].ID, FromAST[0].ID);
+    EXPECT_EQ((*FromShard)[0].PreferredDeclaration,
+              FromAST[0].PreferredDeclaration);
+    EXPECT_EQ((*FromShard)[0].Definition, FromAST[0].Definition);
+  }
+  // And the expected places: declaration in the header, definition in A.cc.
+  auto Foo = locateSymbolFromShard(*Shard, MainPath, Main.code(),
+                                   Main.point("call"), Idx.get());
+  ASSERT_TRUE(Foo);
+  EXPECT_EQ((*Foo)[0].PreferredDeclaration.uri.file(), testPath("root/foo.h"));
+  EXPECT_EQ((*Foo)[0].PreferredDeclaration.range, Header.range("decl"));
+  ASSERT_TRUE((*Foo)[0].Definition);
+  EXPECT_EQ((*Foo)[0].Definition->uri.file(), MainPath);
+  EXPECT_EQ((*Foo)[0].Definition->range, Main.range("def"));
+}
+
+TEST_F(NavigationFromShardTest, NoAnswerWhereTheShardCannotTell) {
+  auto Shard = Idx->loadShard(MainPath);
+  ASSERT_TRUE(Shard);
+  // No reference recorded at a keyword, or at `auto` (a deduced type needs the
+  // AST).
+  EXPECT_FALSE(locateSymbolFromShard(*Shard, MainPath, Main.code(),
+                                     Main.point("kw"), Idx.get()));
+  EXPECT_FALSE(locateSymbolFromShard(*Shard, MainPath, Main.code(),
+                                     Main.point("auto"), Idx.get()));
+  // Function-local symbols are not indexed, so their uses have no reference.
+  EXPECT_FALSE(locateSymbolFromShard(*Shard, MainPath, Main.code(),
+                                     Main.point("use"), Idx.get()));
+  // Content changed since indexing: positions may be off.
+  std::string Edited = "// edited\n" + Main.code().str();
+  EXPECT_FALSE(locateSymbolFromShard(*Shard, MainPath, Edited,
+                                     Main.point("call"), Idx.get()));
+  EXPECT_FALSE(findReferencesFromShard(*Shard, MainPath, Edited,
+                                       Main.point("call"), 0, Idx.get()));
+}
+
+TEST_F(NavigationFromShardTest, ReferencesMatchTheAST) {
+  auto Shard = Idx->loadShard(MainPath);
+  ASSERT_TRUE(Shard);
+  ParsedAST AST = buildAST();
+  for (llvm::StringRef Point : {"call", "type"}) {
+    SCOPED_TRACE(Point);
+    auto FromShard = findReferencesFromShard(*Shard, MainPath, Main.code(),
+                                             Main.point(Point), 0, Idx.get());
+    ASSERT_TRUE(FromShard);
+    auto FromAST = findReferences(AST, Main.point(Point), 0, Idx.get());
+    EXPECT_EQ(sorted(*FromShard), sorted(FromAST));
+  }
+  auto Foo = findReferencesFromShard(*Shard, MainPath, Main.code(),
+                                     Main.point("call"), 0, Idx.get());
+  ASSERT_TRUE(Foo);
+  EXPECT_EQ(Foo->References.size(), 3u); // declaration, definition, call
+  // A limit truncates and reports more.
+  auto Limited = findReferencesFromShard(*Shard, MainPath, Main.code(),
+                                         Main.point("call"), 1, Idx.get());
+  ASSERT_TRUE(Limited);
+  EXPECT_EQ(Limited->References.size(), 1u);
+  EXPECT_TRUE(Limited->HasMore);
+}
+
