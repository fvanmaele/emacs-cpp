+std::optional<SymbolID> symbolAtFromShard(const IndexFileIn &Shard,
+                                          llvm::StringRef MainFilePath,
+                                          llvm::StringRef Content,
+                                          Position Pos) {
+  if (!Shard.Sources || !Shard.Refs)
+    return std::nullopt;
+  std::string FileURI = URI::create(MainFilePath).toString();
+  // The shard's positions are only valid for the content it was built from.
+  auto Node = Shard.Sources->find(FileURI);
+  if (Node == Shard.Sources->end() || Node->getValue().Digest != digest(Content) ||
+      (Node->getValue().Flags & IncludeGraphNode::SourceFlag::HadErrors))
+    return std::nullopt;
+
+  auto Key = [](uint32_t Line, uint32_t Column) {
+    return std::make_pair(Line, Column);
+  };
+  const auto Cursor = Key(Pos.line, Pos.character);
+  std::optional<SymbolID> Best;
+  std::pair<uint32_t, uint32_t> BestStart, BestEnd;
+  for (const auto &[ID, Refs] : *Shard.Refs) {
+    for (const Ref &R : Refs) {
+      if (llvm::StringRef(R.Location.FileURI) != FileURI)
+        continue;
+      auto Start = Key(R.Location.Start.line(), R.Location.Start.column());
+      auto End = Key(R.Location.End.line(), R.Location.End.column());
+      // Like the AST path, a token touching the cursor at either end counts.
+      if (Start > Cursor || Cursor > End)
+        continue;
+      // Prefer the innermost range when references nest.
+      if (!Best || (Start >= BestStart && End <= BestEnd)) {
+        Best = ID;
+        BestStart = Start;
+        BestEnd = End;
+      }
+    }
+  }
+  return Best;
+}
+
+std::optional<std::vector<LocatedSymbol>>
+locateSymbolFromShard(const IndexFileIn &Shard, llvm::StringRef MainFilePath,
+                      llvm::StringRef Content, Position Pos,
+                      const SymbolIndex *Index) {
+  auto ID = symbolAtFromShard(Shard, MainFilePath, Content, Pos);
+  if (!ID)
+    return std::nullopt;
+  std::optional<LocatedSymbol> Result;
+  auto FromSymbol = [&](const Symbol &Sym) {
+    LocatedSymbol Located;
+    Located.Name = Sym.Name.str();
+    Located.ID = Sym.ID;
+    Located.Definition = toLSPLocation(Sym.Definition, MainFilePath);
+    if (auto Decl = toLSPLocation(Sym.CanonicalDeclaration, MainFilePath))
+      Located.PreferredDeclaration = std::move(*Decl);
+    else if (Located.Definition)
+      Located.PreferredDeclaration = *Located.Definition;
+    else
+      return;
+    Result = std::move(Located);
+  };
+  if (Index) {
+    LookupRequest Req;
+    Req.IDs.insert(*ID);
+    Index->lookup(Req, FromSymbol);
+  }
+  if (!Result && Shard.Symbols) {
+    auto It = Shard.Symbols->find(*ID);
+    if (It != Shard.Symbols->end())
+      FromSymbol(*It);
+  }
+  if (!Result)
+    return std::nullopt;
+  return std::vector<LocatedSymbol>{std::move(*Result)};
+}
+
+std::optional<ReferencesResult>
+findReferencesFromShard(const IndexFileIn &Shard, llvm::StringRef MainFilePath,
+                        llvm::StringRef Content, Position Pos, uint32_t Limit,
+                        const SymbolIndex *Index) {
+  if (!Index)
+    return std::nullopt;
+  auto ID = symbolAtFromShard(Shard, MainFilePath, Content, Pos);
+  if (!ID)
+    return std::nullopt;
+  ReferencesResult Results;
+  RefsRequest Req;
+  Req.IDs.insert(*ID);
+  if (Limit)
+    Req.Limit = Limit;
+  Results.HasMore = Index->refs(Req, [&](const Ref &R) {
+    auto LSPLoc = toLSPLocation(R.Location, MainFilePath);
+    if (!LSPLoc)
+      return;
+    ReferencesResult::Reference Result;
+    Result.Loc = {std::move(*LSPLoc), std::nullopt};
+    // Same attribute mapping as findReferences for index results.
+    if ((R.Kind & RefKind::Declaration) == RefKind::Declaration)
+      Result.Attributes |= ReferencesResult::Declaration;
+    if ((R.Kind & RefKind::Definition) == RefKind::Definition)
+      Result.Attributes |=
+          ReferencesResult::Declaration | ReferencesResult::Definition;
+    Results.References.push_back(std::move(Result));
+  });
+  if (Limit && Results.References.size() > Limit) {
+    Results.References.resize(Limit);
+    Results.HasMore = true;
+  }
+  return Results;
+}
+
 } // namespace clangd
 } // namespace clang
