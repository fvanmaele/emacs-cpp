+struct IndexFileIn;
+
+/// Returns the symbol referenced at \p Pos of the file \p MainFilePath, looked
+/// up in the background-index shard of that file instead of a parsed AST.
+/// Answers only when \p Content, the file's current text, is the text the shard
+/// was built from (equal digest, built without errors); returns std::nullopt
+/// otherwise, or when the shard records no reference at \p Pos (e.g. `auto`,
+/// #include lines, comments). Callers then use the AST.
+std::optional<SymbolID> symbolAtFromShard(const IndexFileIn &Shard,
+                                          llvm::StringRef MainFilePath,
+                                          llvm::StringRef Content,
+                                          Position Pos);
+
+/// locateSymbolAt for the symbol given by symbolAtFromShard, answered from
+/// \p Index (or the shard's own symbols), without an AST. Returns std::nullopt
+/// when the shard cannot answer.
+std::optional<std::vector<LocatedSymbol>>
+locateSymbolFromShard(const IndexFileIn &Shard, llvm::StringRef MainFilePath,
+                      llvm::StringRef Content, Position Pos,
+                      const SymbolIndex *Index);
+
+/// findReferences for the symbol given by symbolAtFromShard, answered from
+/// \p Index, without an AST. \p Limit limits the number of results (0 means
+/// no limit). Returns std::nullopt when the shard cannot answer.
+std::optional<ReferencesResult>
+findReferencesFromShard(const IndexFileIn &Shard, llvm::StringRef MainFilePath,
+                        llvm::StringRef Content, Position Pos, uint32_t Limit,
+                        const SymbolIndex *Index);
+
 /// Get info about symbols at \p Pos.
 std::vector<SymbolDetails> getSymbolInfo(ParsedAST &AST, Position Pos);
 
