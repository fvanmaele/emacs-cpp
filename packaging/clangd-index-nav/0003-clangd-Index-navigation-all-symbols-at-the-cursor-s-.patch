+TEST(NavigationFromShard, AllSymbolsAtTheSameRangeAreTargets) {
+  // Seen on a real project: a call recorded as referring to two declarations
+  // at the same range. Keeping one of them lost references of the other.
+  std::string Path = testPath("p/a.cc");
+  std::string FileURI = URI::create(Path).toString();
+  std::string OtherURI = URI::create(testPath("p/b.cc")).toString();
+  llvm::StringRef Content = "int x = call();\n";
+  SymbolID First = SymbolID("first"), Second = SymbolID("second");
+
+  auto Location = [](llvm::StringRef URI, unsigned Line, unsigned Begin,
+                     unsigned End) {
+    SymbolLocation L;
+    L.FileURI = URI.data();
+    L.Start.setLine(Line);
+    L.Start.setColumn(Begin);
+    L.End.setLine(Line);
+    L.End.setColumn(End);
+    return L;
+  };
+  RefSlab::Builder Refs;
+  Ref Here;
+  Here.Location = Location(FileURI, 0, 8, 12);
+  Here.Kind = RefKind::Reference | RefKind::Spelled;
+  Refs.insert(First, Here);
+  Refs.insert(Second, Here);
+  Ref Elsewhere;
+  Elsewhere.Location = Location(OtherURI, 3, 2, 6);
+  Elsewhere.Kind = RefKind::Reference | RefKind::Spelled;
+  Refs.insert(Second, Elsewhere);
+
+  IndexFileIn Shard;
+  Shard.Refs = std::move(Refs).build();
+  IncludeGraph Sources;
+  IncludeGraphNode &Node = Sources[FileURI];
+  Node.URI = FileURI;
+  Node.Digest = digest(Content);
+  Shard.Sources = std::move(Sources);
+
+  auto IDs = symbolsAtFromShard(Shard, Path, Content, Position{0, 9});
+  EXPECT_THAT(IDs, UnorderedElementsAre(First, Second));
+
+  // References of both are reported; the index here holds just the shard.
+  RefSlab::Builder IndexRefs;
+  for (const auto &[ID, Rs] : *Shard.Refs)
+    for (const Ref &R : Rs)
+      IndexRefs.insert(ID, R);
+  auto Index = MemIndex::build(SymbolSlab(), std::move(IndexRefs).build(),
+                               RelationSlab());
+  auto Result = findReferencesToIndexedSymbols(IDs, Path, 0, Index.get());
+  ASSERT_TRUE(Result);
+  // The shared reference is reported once: here, and in b.cc.
+  EXPECT_EQ(Result->References.size(), 2u);
 }
 
 TEST_F(NavigationFromShardTest, ReferencesMatchTheAST) {
