+TEST_F(NavigationFromShardTest, IncludeLineMatchesTheAST) {
+  auto Shard = Idx->loadShard(MainPath);
+  ASSERT_TRUE(Shard);
+  ParsedAST AST = buildAST();
+  auto FromShard =
+      locateIncludeFromShard(*Shard, MainPath, Main.code(), Main.point("inc"));
+  ASSERT_TRUE(FromShard);
+  auto FromAST = locateSymbolAt(AST, Main.point("inc"), Idx.get());
+  ASSERT_EQ(FromAST.size(), 1u);
+  EXPECT_EQ(FromShard->Name, FromAST[0].Name);
+  EXPECT_EQ(FromShard->PreferredDeclaration, FromAST[0].PreferredDeclaration);
+  EXPECT_EQ(FromShard->Definition, FromAST[0].Definition);
+  EXPECT_EQ(FromShard->PreferredDeclaration.uri.file(), testPath("root/foo.h"));
+  // Not on an #include line; or the content changed since indexing.
+  EXPECT_FALSE(locateIncludeFromShard(*Shard, MainPath, Main.code(),
+                                      Main.point("call")));
+  std::string Edited = "// edited\n" + Main.code().str();
+  EXPECT_FALSE(locateIncludeFromShard(*Shard, MainPath, Edited,
+                                      Main.point("inc")));
+}
+
+TEST(NavigationFromShard, IncludeLineNeedsExactlyOneMatchingInclude) {
+  std::string Path = testPath("p/src/a.cc");
+  std::string FileURI = URI::create(Path).toString();
+  std::vector<std::string> IncludeURIs = {
+      URI::create(testPath("p/include/one/x.h")).toString(),
+      URI::create(testPath("p/include/two/x.h")).toString(),
+      URI::create(testPath("p/include/max.h")).toString(),
+      URI::create(testPath("p/include/rmo/option.h")).toString()};
+  llvm::StringRef Content = "#include <rmo/option.h>\n"
+                            "  #  include \"one/x.h\"\n"
+                            "#include \"x.h\"\n"
+                            "#include \"../include/max.h\"\n"
+                            "#include HEADER\n"
+                            "#include \"ax.h\"\n"
+                            "#include <rmo/option.h\n"
+                            "int main();\n";
+  IndexFileIn Shard;
+  IncludeGraph Sources;
+  IncludeGraphNode &Node = Sources[FileURI];
+  Node.URI = FileURI;
+  Node.Digest = digest(Content);
+  // Errors elsewhere in the file do not change which headers were included.
+  Node.Flags = IncludeGraphNode::SourceFlag::HadErrors;
+  for (const std::string &U : IncludeURIs)
+    Node.DirectIncludes.push_back(U);
+  Shard.Sources = std::move(Sources);
+
+  auto At = [&](int Line, int Column = 0) {
+    return locateIncludeFromShard(Shard, Path, Content, Position{Line, Column});
+  };
+  auto Option = At(0, 12);
+  ASSERT_TRUE(Option);
+  EXPECT_EQ(Option->Name, "option.h");
+  EXPECT_EQ(Option->PreferredDeclaration.uri.file(),
+            testPath("p/include/rmo/option.h"));
+  EXPECT_EQ(Option->PreferredDeclaration.range, Range{});
+  EXPECT_EQ(Option->Definition, Option->PreferredDeclaration);
+  // Spaces around '#', quotes, a directory that tells the two x.h apart.
+  auto One = At(1);
+  ASSERT_TRUE(One);
+  EXPECT_EQ(One->PreferredDeclaration.uri.file(),
+            testPath("p/include/one/x.h"));
+  EXPECT_FALSE(At(2)); // two direct includes end with /x.h
+  EXPECT_FALSE(At(3)); // ".." needs the includer's directory
+  EXPECT_FALSE(At(4)); // a macro names the header
+  EXPECT_FALSE(At(5)); // max.h ends with "ax.h" but not with "/ax.h"
+  EXPECT_FALSE(At(6)); // no closing '>'
+  EXPECT_FALSE(At(7)); // not an #include line
+  EXPECT_FALSE(At(42)); // past the end
+}
