+namespace {
+// The shard's include graph node of \p MainFilePath if the shard was built from
+// \p Content, else nullptr with the reason in \p Why.
+const IncludeGraphNode *shardNodeFor(const IndexFileIn &Shard,
+                                     llvm::StringRef MainFilePath,
+                                     llvm::StringRef Content,
+                                     llvm::StringRef &Why) {
+  if (!Shard.Sources) {
+    Why = "the shard has no include graph";
+    return nullptr;
+  }
+  auto Node = Shard.Sources->find(URI::create(MainFilePath).toString());
+  if (Node == Shard.Sources->end()) {
+    Why = "the shard does not describe the file";
+    return nullptr;
+  }
+  if (Node->getValue().Digest != digest(Content)) {
+    Why = "the file changed since it was indexed";
+    return nullptr;
+  }
+  return &Node->getValue();
+}
+} // namespace
+
+llvm::StringRef whyShardCannotAnswer(const IndexFileIn &Shard,
+                                     llvm::StringRef MainFilePath,
+                                     llvm::StringRef Content) {
+  llvm::StringRef Why;
+  const IncludeGraphNode *Node =
+      shardNodeFor(Shard, MainFilePath, Content, Why);
+  if (!Node)
+    return Why;
+  if (Node->Flags & IncludeGraphNode::SourceFlag::HadErrors)
+    return "the file was indexed with errors";
+  if (!Shard.Refs)
+    return "the shard has no references";
+  return "";
+}
+
+std::optional<LocatedSymbol> locateIncludeFromShard(const IndexFileIn &Shard,
+                                                    llvm::StringRef MainFilePath,
+                                                    llvm::StringRef Content,
+                                                    Position Pos) {
+  llvm::StringRef Why;
+  const IncludeGraphNode *Node =
+      shardNodeFor(Shard, MainFilePath, Content, Why);
+  if (!Node)
+    return std::nullopt;
+  // The line at the cursor: the AST path answers anywhere on an #include line.
+  llvm::SmallVector<llvm::StringRef> Lines;
+  Content.split(Lines, '\n');
+  if (Pos.line < 0 || static_cast<size_t>(Pos.line) >= Lines.size())
+    return std::nullopt;
+  llvm::StringRef Line = Lines[Pos.line].trim();
+  if (!Line.consume_front("#"))
+    return std::nullopt;
+  Line = Line.ltrim();
+  if (!Line.consume_front("include_next") && !Line.consume_front("include") &&
+      !Line.consume_front("import"))
+    return std::nullopt;
+  Line = Line.ltrim();
+  char Close = Line.starts_with("<") ? '>' : Line.starts_with("\"") ? '"' : 0;
+  if (!Close) // e.g. a macro naming the header: needs the preprocessor.
+    return std::nullopt;
+  llvm::StringRef Spelled = Line.drop_front().split(Close).first;
+  if (Spelled.empty() || Spelled.size() + 1 >= Line.size())
+    return std::nullopt;
+  // "." and ".." components would need the includer's directory: leave them
+  // to the AST.
+  for (auto It = llvm::sys::path::begin(Spelled, llvm::sys::path::Style::posix),
+            End = llvm::sys::path::end(Spelled);
+       It != End; ++It)
+    if (*It == "." || *It == "..")
+      return std::nullopt;
+  // The header is the one direct include whose path ends with the spelled
+  // name: the include graph records the resolved headers of exactly this
+  // content. With no match or more than one, the AST decides.
+  std::optional<std::string> Resolved;
+  for (llvm::StringRef IncludeURI : Node->DirectIncludes) {
+    auto Path = URI::resolve(IncludeURI, MainFilePath);
+    if (!Path) {
+      llvm::consumeError(Path.takeError());
+      continue;
+    }
+    llvm::StringRef P = *Path;
+    if (!P.consume_back(Spelled) || !P.ends_with("/"))
+      continue;
+    if (Resolved && *Resolved != *Path)
+      return std::nullopt;
+    Resolved = std::move(*Path);
+  }
+  if (!Resolved)
+    return std::nullopt;
+  LocatedSymbol File;
+  File.Name = std::string(llvm::sys::path::filename(*Resolved));
+  File.PreferredDeclaration = {URIForFile::canonicalize(*Resolved, MainFilePath),
+                               Range{}};
+  File.Definition = File.PreferredDeclaration;
+  return File;
+}
