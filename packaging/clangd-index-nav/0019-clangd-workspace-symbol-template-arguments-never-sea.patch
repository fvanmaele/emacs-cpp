   EXPECT_FALSE(tieredMatch("Unrelated", "ector", std::nullopt));
 }
 
+TEST(TieredMatch, WorkspaceSymbolMatch) {
+  FuzzyMatcher Ector("ector");
+  // Off, or a query below the threshold: the fuzzy match, first tier.
+  EXPECT_FALSE(workspaceSymbolMatch(Ector, "Vector", "ector", 0));
+  EXPECT_FALSE(workspaceSymbolMatch(Ector, "Vector", "ector", 6));
+  auto Fuzzy = workspaceSymbolMatch(Ector, "Ector", "ector", 0);
+  ASSERT_TRUE(Fuzzy);
+  EXPECT_TRUE(Fuzzy->FirstTier);
+  // On: mid-word matches, second tier.
+  auto Inside = workspaceSymbolMatch(Ector, "Vector", "ector", 3);
+  ASSERT_TRUE(Inside);
+  EXPECT_FALSE(Inside->FirstTier);
+  // Template arguments are searched neither contiguously nor fuzzily.
+  EXPECT_FALSE(workspaceSymbolMatch(
+      Ector, "EBOBaseImpl<T, true, CtorNotOnDevice>", "ector", 3));
+  // An operator keeps its `<`.
+  FuzzyMatcher Shift("tor<<");
+  EXPECT_TRUE(workspaceSymbolMatch(Shift, "operator<<", "tor<<", 3));
+}
+
 TEST(TieredMatch, SecondTierScore) {
