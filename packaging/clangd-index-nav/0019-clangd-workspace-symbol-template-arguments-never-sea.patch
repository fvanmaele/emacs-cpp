@@ -56,6 +56,7 @@
 //===----------------------------------------------------------------------===//
 
 #include "FuzzyMatch.h"
+#include "llvm/ADT/StringExtras.h"
 #include "llvm/Support/Format.h"
 #include <optional>
 
@@ -86,12 +87,37 @@ FuzzyMatcher::FuzzyMatcher(llvm::StringRef Pattern)
                               llvm::MutableArrayRef(PatRole, PatN));
 }
 
+namespace {
+// The name without template arguments or a destructor's `~`. An operator's
+// `<` is its name ("operator<<"), not the start of arguments.
+llvm::StringRef identifierOf(llvm::StringRef Word) {
+  llvm::StringRef Identifier = Word;
+  bool Operator = Word.starts_with("operator") && Word.size() > 8 &&
+                  !llvm::isAlnum(Word[8]) && Word[8] != '_';
+  if (!Operator)
+    Identifier = Word.take_until([](char C) { return C == '<'; });
+  Identifier.consume_front("~");
+  return Identifier;
+}
+} // namespace
+
+std::optional<TieredMatch> workspaceSymbolMatch(FuzzyMatcher &Filter,
+                                                llvm::StringRef Name,
+                                                llvm::StringRef Query,
+                                                unsigned MiddleMatch) {
+  if (!MiddleMatch || Query.size() < MiddleMatch) {
+    if (auto Score = Filter.match(Name))
+      return TieredMatch{*Score, true};
+    return std::nullopt;
+  }
+  llvm::StringRef Identifier = identifierOf(Name);
+  return tieredMatch(Identifier, Query, Filter.match(Identifier));
+}
+
 std::optional<TieredMatch> tieredMatch(llvm::StringRef Word,
                                        llvm::StringRef Query,
                                        std::optional<float> FuzzyScore) {
-  llvm::StringRef Identifier =
-      Word.take_until([](char C) { return C == '<'; });
-  Identifier.consume_front("~");
+  llvm::StringRef Identifier = identifierOf(Word);
   if (Query.empty() || Identifier.empty()) {
     if (FuzzyScore)
       return TieredMatch{*FuzzyScore, true};
diff --git a/clang-tools-extra/clangd/FuzzyMatch.h b/clang-tools-extra/clangd/FuzzyMatch.h
index ccf0ed8..02b4db4 100644
--- a/clang-tools-extra/clangd/FuzzyMatch.h
+++ b/clang-tools-extra/clangd/FuzzyMatch.h
@@ -88,6 +88,17 @@ std::optional<TieredMatch> tieredMatch(llvm::StringRef Word,
 // [-1, 0), larger scores still ranking higher.
 inline float secondTierScore(float Score) { return -1.0f / (1.0f + Score); }
 
+class FuzzyMatcher;
+// A symbol name's match for workspace symbols: with mid-word matches (a query
+// of at least \p MiddleMatch characters, 0 for never) the tiered match of the
+// name without its template arguments, the fuzzy match included, so that
+// arguments are never searched; otherwise \p Filter's match, first tier.
+// The one rule of Dex, MemIndex and getWorkspaceSymbols.
+std::optional<TieredMatch> workspaceSymbolMatch(FuzzyMatcher &Filter,
+                                                llvm::StringRef Name,
+                                                llvm::StringRef Query,
+                                                unsigned MiddleMatch);
+
 // A matcher capable of matching and scoring strings against a single pattern.
 // It's optimized for matching against many strings - match() does not allocate.
 class FuzzyMatcher {
