+TEST_F(LSPTest, WorkspaceSymbolMatchOptions) {
+  // The emacs-cpp extension's fields: null is "not given"; a mid-word
+  // threshold below 3 is an error, not silently raised.
+  auto &Client = start();
+  Client.didOpen("foo.cpp", "struct TangentVector {};");
+  Client.sync();
+  EXPECT_TRUE(bool(Client
+                       .call("workspace/symbol",
+                             llvm::json::Object{{"query", "ector"},
+                                                {"looseScope", nullptr},
+                                                {"middleMatch", nullptr}})
+                       .take()));
+  auto Error = Client
+                   .call("workspace/symbol",
+                         llvm::json::Object{{"query", "ector"},
+                                            {"middleMatch", 2}})
+                   .take();
+  ASSERT_FALSE(bool(Error));
+  EXPECT_THAT(llvm::toString(Error.takeError()),
+              testing::HasSubstr("at least 3"));
+  auto Middle = Client
+                    .call("workspace/symbol",
+                          llvm::json::Object{{"query", "ector"},
+                                             {"middleMatch", 3}})
+                    .takeValue();
+  ASSERT_TRUE(Middle.getAsArray());
+  EXPECT_EQ(Middle.getAsArray()->size(), 1u);
+}
