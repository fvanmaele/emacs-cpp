+// How long navigation from the index waits for the background index to load
+// its stored shards (at startup, after the compile database finds a project).
+// The AST path answers meanwhile; the wait only decides whether the index may.
+constexpr auto NavigationIndexWait = std::chrono::seconds(5);
+} // namespace
+
+void ClangdServer::runNavigationFromIndex(llvm::StringRef Name,
+                                          llvm::unique_function<void()> Action) {
+  // Its own thread, not a TUScheduler worker: the wait for the index must not
+  // hold a slot the AST build it races needs. The request's context goes
+  // along, so a cancelled request stops waiting.
+  NavigationTasks.runAsync(
+      Name, [Action = std::move(Action),
+             Ctx = Context::current().clone()]() mutable {
+        WithContext WithRequestContext(std::move(Ctx));
+        Action();
+      });
+}
+
+bool ClangdServer::waitForNavigationIndex(llvm::function_ref<bool()> Answered,
+                                          llvm::StringRef What,
+                                          PathRef File) {
+  auto Until = std::chrono::steady_clock::now() + NavigationIndexWait;
+  if (BackgroundIdx->waitForLoadedShards(Until, [&] {
+        return ShuttingDown || isCancelled() || Answered();
+      }))
+    return true;
+  if (!Answered() && !ShuttingDown && !isCancelled())
+    vlog("{0} in {1} need the AST: the index's shards were not loaded within "
+         "{2} s",
+         What, File, NavigationIndexWait.count());
   return false;
 }
