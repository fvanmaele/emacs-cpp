+// Shard storage whose loads wait until the gate opens: a background index that
+// is still loading its stored shards, as at startup on a large project.
+class GatedShardStorage : public MemoryShardStorage {
+public:
+  using MemoryShardStorage::MemoryShardStorage;
+  std::unique_ptr<IndexFileIn>
+  loadShard(llvm::StringRef ShardIdentifier) const override {
+    {
+      std::unique_lock<std::mutex> Lock(GateMu);
+      GateOpened.wait(Lock, [&] { return Open; });
+    }
+    return MemoryShardStorage::loadShard(ShardIdentifier);
+  }
+  void open() {
+    {
+      std::lock_guard<std::mutex> Lock(GateMu);
+      Open = true;
+    }
+    GateOpened.notify_all();
+  }
+
+private:
+  mutable std::mutex GateMu;
+  mutable std::condition_variable GateOpened;
+  bool Open = false;
+};
+
+TEST_F(BackgroundIndexTest, WaitForLoadedShards) {
+  // Navigation from the index answers only once the stored shards are merged
+  // into the index: an answer from the first shards loaded would be partial.
+  MockFS FS;
+  FS.Files[testPath("root/b.h")] = "int b();";
+  std::string MainPath = testPath("root/A.cc");
+  FS.Files[MainPath] = "#include \"b.h\"\nint main() { return b(); }";
+  llvm::StringMap<std::string> Storage;
+  size_t CacheHits = 0;
+  tooling::CompileCommand Cmd;
+  Cmd.Filename = MainPath;
+  Cmd.Directory = testPath("root");
+  Cmd.CommandLine = {"clang++", MainPath};
+  {
+    MemoryShardStorage MSS(Storage, CacheHits);
+    OverlayCDB CDB(/*Base=*/nullptr);
+    BackgroundIndex Idx(FS, CDB, [&](llvm::StringRef) { return &MSS; },
+                        /*Opts=*/{});
+    CDB.setCompileCommand(MainPath, Cmd);
+    ASSERT_TRUE(Idx.blockUntilIdleForTest());
+  }
+  GatedShardStorage Gated(Storage, CacheHits);
+  OverlayCDB CDB(/*Base=*/nullptr);
+  BackgroundIndex Idx(FS, CDB, [&](llvm::StringRef) { return &Gated; },
+                      /*Opts=*/{});
+  auto Never = [] { return false; };
+  // No project handed over yet: nothing to wait for.
+  EXPECT_TRUE(Idx.waitForLoadedShards(std::chrono::steady_clock::now(), Never));
+  CDB.setCompileCommand(MainPath, Cmd); // the load starts and waits at the gate
+  auto Start = std::chrono::steady_clock::now();
+  EXPECT_FALSE(Idx.waitForLoadedShards(Start + std::chrono::milliseconds(300),
+                                       Never));
+  EXPECT_GE(std::chrono::steady_clock::now() - Start,
+            std::chrono::milliseconds(300));
+  // A stopped wait (an answered or cancelled request) ends at once.
+  Start = std::chrono::steady_clock::now();
+  EXPECT_FALSE(Idx.waitForLoadedShards(Start + std::chrono::seconds(10),
+                                       [] { return true; }));
+  EXPECT_LT(std::chrono::steady_clock::now() - Start, std::chrono::seconds(1));
+  EXPECT_THAT(runFuzzyFind(Idx, "b"), IsEmpty());
+  Gated.open();
+  EXPECT_TRUE(Idx.waitForLoadedShards(
+      std::chrono::steady_clock::now() + std::chrono::seconds(10), Never));
+  // Loaded means in the index, not only read.
+  EXPECT_THAT(runFuzzyFind(Idx, "b"), Contains(qName("b")));
+  ASSERT_TRUE(Idx.blockUntilIdleForTest());
+}
