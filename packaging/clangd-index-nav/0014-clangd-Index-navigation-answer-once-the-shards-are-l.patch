+  ++ShardsLoading;
+}
+
+bool BackgroundIndex::waitForLoadedShards(
+    std::chrono::steady_clock::time_point Until,
+    llvm::function_ref<bool()> Stop) {
+  // As in includerOf: a project announced but not yet handed over is not
+  // counted yet.
+  CDB.blockUntilIdle(Deadline(Until));
+  std::unique_lock<std::mutex> Lock(IncludersMu);
+  while (ShardsLoading > 0) {
+    auto Now = std::chrono::steady_clock::now();
+    if (Now >= Until)
+      return false;
+    Lock.unlock();
+    bool Stopped = Stop();
+    Lock.lock();
+    if (Stopped)
+      return false;
+    IncludersChanged.wait_until(
+        Lock, std::min(Until, Now + std::chrono::milliseconds(100)),
+        [&] { return ShardsLoading == 0; });
+  }
+  return true;
 }
 
