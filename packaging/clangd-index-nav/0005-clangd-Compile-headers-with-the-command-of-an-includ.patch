+  /// \p Wait. std::nullopt if no source file is known to include \p Header.
+  std::optional<std::string>
+  includerOf(PathRef Header, std::chrono::steady_clock::duration Wait);
+
   /// Boosts priority of indexing related to Path.
   /// Typically used to index TUs when headers are opened.
   void boostRelated(llvm::StringRef Path);
@@ -216,6 +228,15 @@ private:
   llvm::StringMap<ShardVersion> ShardVersions; // Key is absolute file path.
   std::mutex ShardVersionsMu;
 
+  // Header -> a translation unit that includes it (see includerOf).
+  llvm::StringMap<std::string> Includers;
+  // Number of enqueued shard loads (changedFilesTask) not finished yet.
+  unsigned ProjectsLoading = 0;
+  std::mutex IncludersMu;
+  std::condition_variable IncludersChanged;
+  void recordIncluders(llvm::ArrayRef<std::pair<std::string, std::string>>
+                           HeaderAndTU);
+
   BackgroundIndexStorage::Factory IndexStorageFactory;
   // Tries to load shards for the MainFiles and their dependencies.
   std::vector<std::string> loadProject(std::vector<std::string> MainFiles);
