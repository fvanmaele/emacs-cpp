diff --git a/clang-tools-extra/clangd/ClangdServer.cpp b/clang-tools-extra/clangd/ClangdServer.cpp
index b50c9b1ba..6f993d322 100644
--- a/clang-tools-extra/clangd/ClangdServer.cpp
+++ b/clang-tools-extra/clangd/ClangdServer.cpp
@@ -62,6 +62,44 @@ namespace clang {
 namespace clangd {
 namespace {
 
+// The compile database of the TUScheduler with HeaderFlagsFromIndex: a file
+// without a reliable command (a header: the database guesses one from file
+// names) borrows the command of a source file that includes it according to
+// the background index. TUScheduler's own includer cache (open files that were
+// parsed) still takes precedence, as for any command that is not reliable.
+class IncluderFromIndexCDB : public DelegatingCDB {
+public:
+  IncluderFromIndexCDB(const GlobalCompilationDatabase &Base,
+                       const std::unique_ptr<BackgroundIndex> &Index)
+      : DelegatingCDB(&Base), Index(Index) {}
+
+  std::optional<tooling::CompileCommand>
+  getCompileCommand(PathRef File) const override {
+    auto Cmd = DelegatingCDB::getCompileCommand(File);
+    if ((Cmd && Cmd->Heuristic.empty()) || !Index)
+      return Cmd;
+    auto Includer = Index->includerOf(File, std::chrono::seconds(5));
+    if (!Includer) {
+      vlog("Compile command for {0}: no source file includes it in the index",
+           File);
+      return Cmd;
+    }
+    auto IncluderCmd = DelegatingCDB::getCompileCommand(*Includer);
+    if (!IncluderCmd || !IncluderCmd->Heuristic.empty()) {
+      vlog("Compile command for {0}: {1} includes it, but has no command",
+           File, *Includer);
+      return Cmd;
+    }
+    vlog("Compile command for {0} from {1}, which includes it (index)", File,
+         *Includer);
+    return tooling::transferCompileCommand(std::move(*IncluderCmd), File);
+  }
+
+private:
+  // Set after construction (ClangdServer creates the index later).
+  const std::unique_ptr<BackgroundIndex> &Index;
+};
+
 // Tracks number of times a tweak has been offered.
 static constexpr trace::Metric TweakAvailable(
     "tweak_available", trace::Metric::Counter, "tweak_id");
@@ -238,7 +276,10 @@ ClangdServer::ClangdServer(const GlobalCompilationDatabase &CDB,
   // Pass a callback into `WorkScheduler` to extract symbols from a newly
   // parsed file and rebuild the file index synchronously each time an AST
   // is parsed.
-  WorkScheduler.emplace(CDB, TUScheduler::Options(Opts),
+  if (Opts.HeaderFlagsFromIndex && Opts.BackgroundIndex)
+    SchedulerCDB = std::make_unique<IncluderFromIndexCDB>(CDB, BackgroundIdx);
+  WorkScheduler.emplace(SchedulerCDB ? *SchedulerCDB : CDB,
+                        TUScheduler::Options(Opts),
                         std::make_unique<UpdateIndexCallbacks>(
                             DynamicIdx.get(), Callbacks, TFS,
                             IndexTasks ? &*IndexTasks : nullptr,
