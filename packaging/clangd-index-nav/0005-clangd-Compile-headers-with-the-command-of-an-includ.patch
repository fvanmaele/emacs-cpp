     SPAN_ATTACH(Tracer, "files", int64_t(ChangedFiles.size()));
 
     auto NeedsReIndexing = loadProject(std::move(ChangedFiles));
+    {
+      std::lock_guard<std::mutex> Lock(IncludersMu);
+      --ProjectsLoading;
+    }
+    IncludersChanged.notify_all();
     // Run indexing for files that need to be updated.
     std::shuffle(NeedsReIndexing.begin(), NeedsReIndexing.end(),
                  std::mt19937(std::random_device{}()));
@@ -184,6 +189,25 @@ std::unique_ptr<IndexFileIn> BackgroundIndex::loadShard(PathRef File) {
   return IndexStorageFactory(File)->loadShard(File);
 }
 
+void BackgroundIndex::recordIncluders(
+    llvm::ArrayRef<std::pair<std::string, std::string>> HeaderAndTU) {
+  std::lock_guard<std::mutex> Lock(IncludersMu);
+  for (const auto &[Header, TU] : HeaderAndTU)
+    if (Header != TU)
+      Includers.try_emplace(Header, TU);
+}
+
+std::optional<std::string>
+BackgroundIndex::includerOf(PathRef Header,
+                            std::chrono::steady_clock::duration Wait) {
+  std::unique_lock<std::mutex> Lock(IncludersMu);
+  IncludersChanged.wait_for(Lock, Wait, [&] { return ProjectsLoading == 0; });
+  auto It = Includers.find(Header);
+  if (It == Includers.end())
+    return std::nullopt;
+  return It->getValue();
+}
+
 /// Given index results from a TU, only update symbols coming from files that
 /// are different or missing from than \p ShardVersionsSnapshot. Also stores new
 /// index information on IndexStorage.
@@ -193,6 +217,7 @@ void BackgroundIndex::update(
