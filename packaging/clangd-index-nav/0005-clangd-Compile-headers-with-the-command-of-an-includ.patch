diff --git a/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp b/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
index 3143a21e6..2ca45ad27 100644
--- a/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
+++ b/clang-tools-extra/clangd/unittests/BackgroundIndexTests.cpp
@@ -782,6 +782,54 @@ TEST_F(BackgroundIndexTest, DirectIncludesTest) {
               emptyIncludeNode());
 }
 
+TEST_F(BackgroundIndexTest, IncluderOfHeaders) {
+  // HeaderFlagsFromIndex: a header borrows the compile command of a source
+  // file that includes it, directly or through other headers.
+  MockFS FS;
+  FS.Files[testPath("root/inc/b.h")] = "int b();";
+  FS.Files[testPath("root/inc/a.h")] = "#include \"b.h\"\nint a();";
+  FS.Files[testPath("root/inc/unused.h")] = "int u();";
+  std::string MainPath = testPath("root/src/A.cc");
+  FS.Files[MainPath] = "#include <a.h>\nint main() { return a() + b(); }";
+  llvm::StringMap<std::string> Storage;
+  size_t CacheHits = 0;
+  MemoryShardStorage MSS(Storage, CacheHits);
+  tooling::CompileCommand Cmd;
+  Cmd.Filename = MainPath;
+  Cmd.Directory = testPath("root");
+  Cmd.CommandLine = {"clang++", "-I" + testPath("root/inc"), MainPath};
+
+  // Indexed in this session.
+  {
+    OverlayCDB CDB(/*Base=*/nullptr);
+    BackgroundIndex Idx(FS, CDB, [&](llvm::StringRef) { return &MSS; },
+                        /*Opts=*/{});
+    CDB.setCompileCommand(MainPath, Cmd);
+    ASSERT_TRUE(Idx.blockUntilIdleForTest());
+    EXPECT_EQ(Idx.includerOf(testPath("root/inc/a.h"), std::chrono::seconds(0)),
+              MainPath);
+    EXPECT_EQ(Idx.includerOf(testPath("root/inc/b.h"), std::chrono::seconds(0)),
+              MainPath);
+    // Not included by any source file; a source file includes no one.
+    EXPECT_FALSE(Idx.includerOf(testPath("root/inc/unused.h"),
+                                std::chrono::seconds(0)));
+    EXPECT_FALSE(Idx.includerOf(MainPath, std::chrono::seconds(0)));
+  }
+  // A new session: the stored shards are loaded asynchronously; includerOf
+  // waits for the load instead of answering "unknown" too early.
+  {
+    CacheHits = 0;
+    OverlayCDB CDB(/*Base=*/nullptr);
+    BackgroundIndex Idx(FS, CDB, [&](llvm::StringRef) { return &MSS; },
+                        /*Opts=*/{});
+    CDB.setCompileCommand(MainPath, Cmd);
+    EXPECT_EQ(Idx.includerOf(testPath("root/inc/b.h"), std::chrono::seconds(10)),
+              MainPath);
+    ASSERT_TRUE(Idx.blockUntilIdleForTest());
+    EXPECT_EQ(CacheHits, 3U); // A.cc, a.h, b.h loaded; nothing re-indexed.
+  }
+}
