diff --git a/clang-tools-extra/clangd/FindSymbols.cpp b/clang-tools-extra/clangd/FindSymbols.cpp
index 147dd38..3df0e09 100644
--- a/clang-tools-extra/clangd/FindSymbols.cpp
+++ b/clang-tools-extra/clangd/FindSymbols.cpp
@@ -253,6 +253,22 @@ bool approximateScopeMatch(llvm::StringRef Scope, llvm::StringRef Query) {
   return Query.empty();
 }
 
+// Returns true if each segment of \p Query fuzzy-matches a segment of \p Scope,
+// in order: "geom::" matches "dealii::GeometryInfo::".
+bool looseScopeMatch(llvm::StringRef Scope, llvm::StringRef Query) {
+  llvm::SmallVector<llvm::StringRef> Wanted, Segments;
+  Query.split(Wanted, "::", /*MaxSplit=*/-1, /*KeepEmpty=*/false);
+  Scope.split(Segments, "::", /*MaxSplit=*/-1, /*KeepEmpty=*/false);
+  size_t Found = 0;
+  for (llvm::StringRef Segment : Segments) {
+    if (Found == Wanted.size())
+      break;
+    if (FuzzyMatcher(Wanted[Found]).match(Segment))
+      ++Found;
+  }
+  return Found == Wanted.size();
+}
+
 } // namespace
 
