+TEST(WorkspaceSymbols, LooseScope) {
+  TestTU TU;
+  TU.Code = R"cpp(
+      namespace dealii {
+      struct GeometryInfo { static const int vertices_per_cell = 4; };
+      struct Triangulation { int n_active_cells(); };
+      }
+      )cpp";
+  WorkspaceSymbolOptions Loose;
+  Loose.LooseScope = true;
+  // Off unless asked for: an abbreviated qualifier finds nothing.
+  EXPECT_THAT(getSymbols(TU, "geom::vert"), IsEmpty());
+  // Each segment fuzzy-matches a segment of the scope, in order.
+  EXPECT_THAT(getSymbols(TU, "geom::vert", 0, Loose),
+              ElementsAre(qName("dealii::GeometryInfo::vertices_per_cell")));
+  EXPECT_THAT(getSymbols(TU, "dealii::gi::vert", 0, Loose),
+              ElementsAre(qName("dealii::GeometryInfo::vertices_per_cell")));
+  EXPECT_THAT(getSymbols(TU, "tria::n_act", 0, Loose),
+              ElementsAre(qName("dealii::Triangulation::n_active_cells")));
+  // Out of order, or no segment to match: nothing.
+  EXPECT_THAT(getSymbols(TU, "geom::dealii::vert", 0, Loose), IsEmpty());
+  EXPECT_THAT(getSymbols(TU, "mesh::vert", 0, Loose), IsEmpty());
+  // Exact qualifiers match as before.
+  EXPECT_THAT(getSymbols(TU, "GeometryInfo::vert", 0, Loose),
+              ElementsAre(qName("dealii::GeometryInfo::vertices_per_cell")));
+}
