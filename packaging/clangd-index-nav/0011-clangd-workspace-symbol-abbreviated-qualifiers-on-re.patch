+    if (AnyScope && !approximateScopeMatch(Scope, ReqScope) &&
+        !(Opts.LooseScope && looseScopeMatch(Scope, ReqScope)))
       return;
 
     auto Loc = symbolToLocation(Sym, HintPath);
