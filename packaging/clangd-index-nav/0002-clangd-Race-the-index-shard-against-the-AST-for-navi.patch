 }
 
+TEST_F(NavigationFromShardTest, NoAnswerBeforeTheIndexKnowsTheSymbol) {
+  // At startup the background index loads its stored shards asynchronously;
+  // until then a symbol of another file is unknown. The server keeps asking
+  // (while the AST path runs), so both lookups must say "not yet".
+  auto Shard = Idx->loadShard(MainPath);
+  ASSERT_TRUE(Shard);
+  auto ID = symbolAtFromShard(*Shard, MainPath, Main.code(), Main.point("type"));
+  ASSERT_TRUE(ID);
+  auto Empty = MemIndex::build(SymbolSlab(), RefSlab(), RelationSlab());
+  EXPECT_FALSE(locateIndexedSymbol(*ID, *Shard, MainPath, Empty.get()));
+  EXPECT_FALSE(findReferencesToIndexedSymbol(*ID, MainPath, 0, Empty.get()));
+  // Once the index has it, both answer.
+  EXPECT_TRUE(locateIndexedSymbol(*ID, *Shard, MainPath, Idx.get()));
+  EXPECT_TRUE(findReferencesToIndexedSymbol(*ID, MainPath, 0, Idx.get()));
+}
