+namespace {
+// Hands a request's result to its callback once, from whichever of two paths
+// answers first: the background-index shard (NavigationFromIndex) or the AST.
+template <typename T> class FirstAnswer {
+public:
+  explicit FirstAnswer(Callback<T> CB) : CB(std::move(CB)) {}
+  bool answered() const { return Done; }
+  // Returns true if this call delivered the result.
+  bool answer(llvm::Expected<T> Result) {
+    std::lock_guard<std::mutex> Lock(Mu);
+    if (Done) {
+      if (!Result)
+        llvm::consumeError(Result.takeError());
+      return false;
+    }
+    Done = true;
+    CB(std::move(Result));
+    return true;
+  }
+
+private:
+  std::mutex Mu;
+  std::atomic<bool> Done{false};
+  Callback<T> CB;
+};
+
+// Asks Query every 50 ms until it answers, the AST path has answered, or 5 s
+// have passed. The background index loads its stored shards asynchronously at
+// startup, so symbols of other files may only become available shortly after.
+template <typename T>
+bool pollIndex(FirstAnswer<T> &Answer,
+               llvm::function_ref<std::optional<T>()> Query) {
+  auto Deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!Answer.answered() && std::chrono::steady_clock::now() < Deadline) {
+    if (auto Result = Query())
+      return Answer.answer(std::move(*Result));
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+  }
+  return false;
+}
+} // namespace
+
+std::optional<std::pair<std::shared_ptr<IndexFileIn>, SymbolID>>
+ClangdServer::indexedSymbolAt(PathRef File, Position Pos) {
+  if (!NavigationFromIndex || !BackgroundIdx)
+    return std::nullopt;
+  auto Draft = getDraft(File);
+  if (!Draft)
+    return std::nullopt;
+  std::shared_ptr<IndexFileIn> Shard = BackgroundIdx->loadShard(File);
+  if (!Shard)
+    return std::nullopt;
+  auto ID = clangd::symbolAtFromShard(*Shard, File, *Draft, Pos);
+  if (!ID)
+    return std::nullopt;
+  return std::make_pair(std::move(Shard), *ID);
+}
