diff --git a/clang-tools-extra/clangd/unittests/DexTests.cpp b/clang-tools-extra/clangd/unittests/DexTests.cpp
index ca8b81b..7071263 100644
--- a/clang-tools-extra/clangd/unittests/DexTests.cpp
+++ b/clang-tools-extra/clangd/unittests/DexTests.cpp
@@ -536,6 +536,21 @@ TEST(DexTest, FuzzyMatch) {
               UnorderedElementsAre("LaughingOutLoud", "LittleOldLady"));
 }
 
+TEST(DexTest, MiddleMatch) {
+  auto I = Dex::build(generateSymbols({"Ector", "TangentVector", "Unrelated"}),
+                      RefSlab(), RelationSlab(), true);
+  FuzzyFindRequest Req;
+  Req.Query = "ector";
+  Req.AnyScope = true;
+  // Off by default, as code completion asks: only the fuzzy match.
+  EXPECT_THAT(match(*I, Req), UnorderedElementsAre("Ector"));
+  Req.MiddleMatch = 3;
+  EXPECT_THAT(match(*I, Req), UnorderedElementsAre("Ector", "TangentVector"));
+  // The mid-word match scores below the fuzzy one, so it goes first at a limit.
+  Req.Limit = 1;
+  EXPECT_THAT(match(*I, Req), UnorderedElementsAre("Ector"));
+}
