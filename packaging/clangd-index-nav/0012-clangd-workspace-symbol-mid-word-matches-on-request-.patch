diff --git a/clang-tools-extra/clangd/FuzzyMatch.h b/clang-tools-extra/clangd/FuzzyMatch.h
index a8621d6..532e709 100644
--- a/clang-tools-extra/clangd/FuzzyMatch.h
+++ b/clang-tools-extra/clangd/FuzzyMatch.h
@@ -68,6 +68,16 @@ CharTypeSet calculateRoles(llvm::StringRef Text,
 
 // A matcher capable of matching and scoring strings against a single pattern.
 // It's optimized for matching against many strings - match() does not allocate.
+// Whether \p Word's identifier (the part before any template arguments: the
+// constructor of a class template is named "Holder<VectorType>") contains
+// \p Pattern, in any case. A match of last resort for workspace symbols
+// ("ector" in "TangentVector"), which FuzzyMatcher refuses because the pattern
+// does not start a word segment.
+inline bool containsInIdentifier(llvm::StringRef Word, llvm::StringRef Pattern) {
+  return Word.take_until([](char C) { return C == '<'; })
+      .contains_insensitive(Pattern);
+}
+
 class FuzzyMatcher {
 public:
   // Characters beyond MaxPat are ignored.
