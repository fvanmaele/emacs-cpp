@@ -220,6 +220,28 @@ TEST(WorkspaceSymbols, LooseScope) {
               ElementsAre(qName("dealii::GeometryInfo::vertices_per_cell")));
 }
 
+TEST(WorkspaceSymbols, MiddleMatch) {
+  TestTU TU;
+  TU.Code = R"cpp(
+      struct Ector {};
+      struct TangentVector {};
+      template <typename VectorType> struct Holder { Holder(); };
+      )cpp";
+  WorkspaceSymbolOptions Middle;
+  Middle.MiddleMatch = 3;
+  // Off unless asked for: only the fuzzy match.
+  EXPECT_THAT(getSymbols(TU, "ector"), ElementsAre(qName("Ector")));
+  // Asked for: mid-word matches after every fuzzy one; not inside template
+  // arguments (Holder's constructor is named "Holder<VectorType>").
+  EXPECT_THAT(getSymbols(TU, "ector", 0, Middle),
+              ElementsAre(qName("Ector"), qName("TangentVector")));
+  // First to go at the limit.
+  EXPECT_THAT(getSymbols(TU, "ector", 1, Middle), ElementsAre(qName("Ector")));
+  // Below the minimum length nothing is added.
+  Middle.MiddleMatch = 6;
+  EXPECT_THAT(getSymbols(TU, "ector", 0, Middle), ElementsAre(qName("Ector")));
+}
