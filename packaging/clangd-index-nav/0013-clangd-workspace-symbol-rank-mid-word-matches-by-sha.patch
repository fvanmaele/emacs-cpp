 }
 
+TEST(MemIndexTest, MiddleMatchTiers) {
+  auto I = MemIndex::build(
+      generateSymbols({"EBOBaseImpl<T, true, CtorNotOnDevice>", "Vector", "Ector"}),
+      RefSlab(), RelationSlab());
+  FuzzyFindRequest Req;
+  Req.Query = "ector";
+  Req.AnyScope = true;
+  Req.MiddleMatch = 3;
+  // As in Dex: contiguous first, then by share or scattered fuzzy score.
+  EXPECT_THAT(match(*I, Req),
+              ElementsAre("Ector", "Vector",
+                          "EBOBaseImpl<T, true, CtorNotOnDevice>"));
+  Req.Limit = 2;
+  EXPECT_THAT(match(*I, Req), ElementsAre("Ector", "Vector"));
+}
