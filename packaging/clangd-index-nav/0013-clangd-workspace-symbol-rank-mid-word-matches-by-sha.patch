 }
 
+TEST(WorkspaceSymbols, MiddleMatchTiers) {
+  TestTU TU;
+  TU.Code = R"cpp(
+      struct Ector {};
+      struct Vector {};
+      struct AlignedVectorCopyConstruct {};
+      template <class T, bool Empty, template <class...> class CtorNotOnDevice>
+      struct EBOBaseImpl;
+      template <class T, template <class...> class CtorNotOnDevice>
+      struct EBOBaseImpl<T, true, CtorNotOnDevice> { EBOBaseImpl(); };
+      )cpp";
+  WorkspaceSymbolOptions Middle;
+  Middle.MiddleMatch = 3;
+  // The match contiguous from a word start first, then the mid-word one that
+  // covers most of its name, before the constructor matched as E + Ctor and
+  // before a longer name.
+  auto Symbols = getSymbols(TU, "ector", 0, Middle);
+  ASSERT_EQ(Symbols.size(), 4u);
+  EXPECT_THAT(Symbols, ElementsAre(qName("Ector"), qName("Vector"), _, _));
+  EXPECT_THAT(Symbols, Contains(qName("AlignedVectorCopyConstruct")));
+  // A limit keeps the best.
+  EXPECT_THAT(getSymbols(TU, "ector", 2, Middle),
+              ElementsAre(qName("Ector"), qName("Vector")));
+}
