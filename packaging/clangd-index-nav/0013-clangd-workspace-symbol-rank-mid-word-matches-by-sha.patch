diff --git a/clang-tools-extra/clangd/unittests/FuzzyMatchTests.cpp b/clang-tools-extra/clangd/unittests/FuzzyMatchTests.cpp
index ad32623..9a32998 100644
--- a/clang-tools-extra/clangd/unittests/FuzzyMatchTests.cpp
+++ b/clang-tools-extra/clangd/unittests/FuzzyMatchTests.cpp
@@ -309,6 +309,45 @@ TEST(FuzzyMatch, Segmentation) {
               returns("+-----")); // Six bytes: ï is encoded as two bytes.
 }
 
+TEST(TieredMatch, Tiers) {
+  // Contiguous from a word start: first tier, the fuzzy score.
+  auto Prefix = tieredMatch("has_boundary_lines", "bou", 0.58f);
+  ASSERT_TRUE(Prefix);
+  EXPECT_TRUE(Prefix->FirstTier);
+  EXPECT_FLOAT_EQ(Prefix->Score, 0.58f);
+  // Inside a word: second tier, the share of the identifier covered, doubled
+  // when the match ends a word segment.
+  auto Inside = tieredMatch("Vector", "ector", std::nullopt);
+  ASSERT_TRUE(Inside);
+  EXPECT_FALSE(Inside->FirstTier);
+  EXPECT_FLOAT_EQ(Inside->Score, 2 * 5.0f / 6);
+  EXPECT_FLOAT_EQ(tieredMatch("~Vector", "ector", std::nullopt)->Score,
+                  2 * 5.0f / 6);
+  EXPECT_FLOAT_EQ(tieredMatch("AlignedVectorCopy", "ector", std::nullopt)->Score,
+                  2 * 5.0f / 17);
+  EXPECT_FLOAT_EQ(tieredMatch("directory", "ector", std::nullopt)->Score,
+                  5.0f / 9);
+  // Scattered over word starts (E + Ctor): second tier, the fuzzy score when
+  // it is higher than the share covered.
+  auto Scattered =
+      tieredMatch("EBOBaseImpl<T, true, CtorNotOnDevice>", "ector", 0.7f);
+  ASSERT_TRUE(Scattered);
+  EXPECT_FALSE(Scattered->FirstTier);
+  EXPECT_FLOAT_EQ(Scattered->Score, 0.7f);
+  // Template arguments are not searched; no match, no rank.
+  EXPECT_FALSE(tieredMatch("Holder<VectorType>", "ector", std::nullopt));
+  EXPECT_FALSE(tieredMatch("Unrelated", "ector", std::nullopt));
+}
+
+TEST(TieredMatch, SecondTierScore) {
+  // Below every first-tier score, which is at least 0.
+  EXPECT_LT(secondTierScore(1e6f), 0.0f);
+  EXPECT_GE(secondTierScore(0.0f), -1.0f);
+  // Close scores keep their order (minus 1e6 in a float rounds to 0.0625).
+  EXPECT_LT(secondTierScore(0.50f), secondTierScore(0.51f));
+  EXPECT_LT(secondTierScore(0.0f), secondTierScore(1e-3f));
+}
+
 } // namespace
 } // namespace clangd
 } // namespace clang
