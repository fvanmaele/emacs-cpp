[submodule "projectile"]
	path = lib/projectile
	url = https://github.com/bbatsov/projectile
	ignore = untracked
	patch = patches/projectile/0001-Search-the-project-s-file-list-in-projectile-find-re.patch
[submodule "treemacs"]
	path = lib/treemacs
	url = https://github.com/Alexander-Miller/treemacs
	ignore = untracked
	load-path = src/elisp
	load-path = src/extra
	build-exclude = src/extra/treemacs-all-the-icons.el
	build-exclude = src/extra/treemacs-evil.el
	build-exclude = src/extra/treemacs-mu4e.el
	build-exclude = src/extra/treemacs-perspective.el
	build-exclude = src/extra/treemacs-persp.el
	patch = patches/treemacs/0001-Don-t-cancel-a-missing-timer-when-project-follow-mod.patch
[submodule "dash"]
	path = lib/dash
	url = https://github.com/magnars/dash.el
	ignore = untracked
	info = dash.texi
[submodule "s"]
	path = lib/s
	url = https://github.com/magnars/s.el
	ignore = untracked
[submodule "ace-window"]
	path = lib/ace-window
	url = https://github.com/abo-abo/ace-window
	ignore = untracked
[submodule "avy"]
	path = lib/avy
	url = https://github.com/abo-abo/avy
	ignore = untracked
[submodule "pfuture"]
	path = lib/pfuture
	url = https://github.com/Alexander-Miller/pfuture
	ignore = untracked
[submodule "hydra"]
	path = lib/hydra
	url = https://github.com/abo-abo/hydra
	ignore = untracked
	build-exclude = hydra-examples.el
[submodule "ht"]
	path = lib/ht
	url = https://github.com/Wilfred/ht.el
	ignore = untracked
[submodule "cfrs"]
	path = lib/cfrs
	url = https://github.com/Alexander-Miller/cfrs
	ignore = untracked
[submodule "posframe"]
	path = lib/posframe
	url = https://github.com/tumashu/posframe
	ignore = untracked
	build-exclude = posframe-benchmark.el
[submodule "magit"]
	path = lib/magit
	url = https://github.com/magit/magit
	ignore = untracked
	load-path = lisp
	info = docs/magit.texi
	info = docs/magit-section.texi
[submodule "with-editor"]
	path = lib/with-editor
	url = https://github.com/magit/with-editor
	ignore = untracked
	load-path = lisp
	info = docs/with-editor.texi
[submodule "cond-let"]
	path = lib/cond-let
	url = https://github.com/tarsius/cond-let
	ignore = untracked
[submodule "llama"]
	path = lib/llama
	url = https://github.com/tarsius/llama
	ignore = untracked
[submodule "markdown-mode"]
	path = lib/markdown-mode
	url = https://github.com/jrblevin/markdown-mode
	ignore = untracked
[submodule "org-journal"]
	path = lib/org-journal
	url = https://github.com/bastibe/org-journal
	ignore = untracked
[submodule "vertico"]
	path = lib/vertico
	url = https://github.com/minad/vertico
	ignore = untracked
	load-path = .
	load-path = extensions
[submodule "orderless"]
	path = lib/orderless
	url = https://github.com/oantolin/orderless
	ignore = untracked
	info = orderless.texi
[submodule "marginalia"]
	path = lib/marginalia
	url = https://github.com/minad/marginalia
	ignore = untracked
[submodule "consult"]
	path = lib/consult
	url = https://github.com/minad/consult
	ignore = untracked
	patch = patches/consult/0001-Drop-a-hidden-source-s-candidates-in-asynchronous-co.patch
[submodule "embark"]
	path = lib/embark
	url = https://github.com/oantolin/embark
	ignore = untracked
	info = embark.texi
[submodule "corfu"]
	path = lib/corfu
	url = https://github.com/minad/corfu
	ignore = untracked
	load-path = .
	load-path = extensions
[submodule "cape"]
	path = lib/cape
	url = https://github.com/minad/cape
	ignore = untracked
[submodule "consult-eglot"]
	path = lib/consult-eglot
	url = https://github.com/mohkale/consult-eglot
	ignore = untracked
	patch = patches/consult-eglot/0001-Keep-each-server-s-workspace-symbol-reply-in-order-a.patch
[submodule "dape"]
	path = lib/dape
	url = https://github.com/svaante/dape
	ignore = untracked
	build-exclude = dape-tests.el
[submodule "diff-hl"]
	path = lib/diff-hl
	url = https://github.com/dgutov/diff-hl
	ignore = untracked
[submodule "breadcrumb"]
	path = lib/breadcrumb
	url = https://github.com/joaotavora/breadcrumb
	ignore = untracked
[submodule "code-cells"]
	path = lib/code-cells
	url = https://github.com/astoff/code-cells.el
	ignore = untracked
[submodule "ess"]
	path = lib/ess
	url = https://github.com/emacs-ess/ESS
	ignore = untracked
	load-path = lisp
	info = doc/ess.texi
[submodule "auctex"]
	path = lib/auctex
	url = https://git.savannah.gnu.org/git/emacs/elpa.git
	branch = externals/auctex
	shallow = true
	ignore = untracked
	info = doc/auctex.texi
	info = doc/preview-latex.texi
	patch = patches/auctex/0001-Add-the-generated-Texinfo-files-of-the-manuals.patch
	build-exclude = lpath.el
[submodule "yasnippet"]
	path = lib/yasnippet
	url = https://git.savannah.gnu.org/git/emacs/elpa.git
	branch = externals/yasnippet
	shallow = true
	ignore = untracked
[submodule "yasnippet-snippets"]
	path = lib/yasnippet-snippets
	url = https://git.savannah.gnu.org/git/emacs/nongnu.git
	branch = elpa/yasnippet-snippets
	shallow = true
	ignore = untracked
	patch = patches/yasnippet-snippets/0001-Load-the-snippets-when-the-package-is-loaded-not-wit.patch
[submodule "eglot"]
	path = lib/eglot
	url = https://github.com/emacs-straight/eglot
	ignore = untracked
	info = eglot.texi
	patch = patches/eglot/0001-Keep-partial-file-watches-when-the-limit-is-reached-.patch
	patch = patches/eglot/0002-Share-one-file-watch-per-directory-among-a-server-s-.patch
