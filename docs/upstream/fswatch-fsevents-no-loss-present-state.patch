+// Records are written by a separate thread, so the monitor's callback never
+// blocks on a slow reader: on macOS a blocked FSEvents callback makes the
+// system drop events.  Records wait in memory until the reader takes them.
+static std::mutex output_mutex;
+static std::condition_variable output_ready;
+static std::deque<std::string> output_queue;
+
+static void write_output()
+{
+  for (;;)
+  {
+    std::string chunk;
+    {
+      std::unique_lock<std::mutex> lock(output_mutex);
+      output_ready.wait(lock, [] { return !output_queue.empty(); });
+      chunk = std::move(output_queue.front());
+      output_queue.pop_front();
+    }
+    if (fwrite(chunk.data(), 1, chunk.size(), stdout) != chunk.size()
+        || fflush(stdout) != 0)
+      std::_Exit(FSW_EXIT_ERROR);
+  }
+}
+
 static void process_events(const std::vector<event>& events, void *)
 {
+  std::ostringstream records;
+  std::streambuf *console = std::cout.rdbuf(records.rdbuf());
   if (oflag)
     write_one_batch_event(events);
   else
     write_events(events);
+  std::cout.rdbuf(console);
+  {
+    std::lock_guard<std::mutex> lock(output_mutex);
+    output_queue.push_back(records.str());
+  }
+  output_ready.notify_one();
 }
 
 static void start_monitor(int argc, char **argv, int argIndex)
@@ -531,6 +569,7 @@ static void start_monitor(int argc, char **argv, int argIndex)
   active_monitor->set_watch_access(aflag);
   active_monitor->set_bubble_events(bflag);
 
+  std::thread(write_output).detach();
   active_monitor->start();
 }
 
