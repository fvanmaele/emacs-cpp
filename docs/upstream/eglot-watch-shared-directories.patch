+(defvar eglot--directory-watches (make-hash-table :test #'eq :weakness 'key)
+  "Server -> hash table DIRECTORY -> (DESCRIPTOR . HANDLERS).
+One file watch per directory, shared by all of a server's registrations;
+HANDLERS is an alist (ID . FUNCTION) of the registrations using it.")
+
+(defun eglot--directory-watches (server)
+  "Return SERVER's table of watched directories."
+  (or (gethash server eglot--directory-watches)
+      (puthash server (make-hash-table :test #'equal) eglot--directory-watches)))
+
+(defun eglot--remove-directory-watches (server)
+  "Stop every file watch of SERVER."
+  (maphash (lambda (_dir entry) (file-notify-rm-watch (car entry)))
+           (eglot--directory-watches server))
+  (remhash server eglot--directory-watches))
+
 (defun eglot--count-file-watches ()
   "Count total file watches across all Eglot servers."
