From 95e742ca5fcd935febd0bf4e3710da6d2d5765b1 Mon Sep 17 00:00:00 2001
From: Ferdinand Vanmaele <ferdinand-joseph.vanmaele@uni-a.de>
Date: Mon, 19 Oct 2026 22:19:55 +0200
Subject: [PATCH] Find declarations, implementations, type definitions with
 xref 1.7.0

eglot-find-declaration, eglot-find-implementation and
eglot-find-type-definition call xref-find-by-kind and
xref-read-identifier, which only Emacs master's xref has.  Eglot
declares (xref "1.7.0"), and with the xref 1.7.0 of Emacs 31.1 each of
them stops with (void-function xref-read-identifier).

eglot--find-by-kind calls them where xref has them; otherwise it reads
the identifier as xref-find-definitions does and shows what the
backend's xref-backend-xrefs-by-kind returns through xref-show-xrefs,
as Emacs 31's eglot showed its finders' results.  It prompts for the
identifier only with a prefix argument or none at point, as the
finders' docstring says and Emacs 31's finders did; the default
xref-prompt-for-identifier would prompt on every call.

eglot-find-typeDefinition was renamed eglot-find-type-definition, but
the menu and the list of Eglot's commands still named the old one,
which no longer existed.  Both now name the new one, and the old name
is an alias for code and keys that still use it.
---
 eglot.el | 34 ++++++++++++++++++++++++++++++----
 1 file changed, 30 insertions(+), 4 deletions(-)

diff --git a/eglot.el b/eglot.el
index 6b66cab..1d6d996 100644
--- a/eglot.el
+++ b/eglot.el
@@ -2626,7 +2626,7 @@ If it is activated, also signal textDocument/didOpen."
     ["Find implementation" eglot-find-implementation
      :help "Find implementation for identifier at point"
      :active (eglot-server-capable :implementationProvider)]
-    ["Find type definition" eglot-find-typeDefinition
+    ["Find type definition" eglot-find-type-definition
      :help "Find type definition for identifier at point"
      :active (eglot-server-capable :typeDefinitionProvider)]
     "--"
@@ -3813,16 +3813,42 @@ EXTRA-ARGS are added to the request."
       (make-xrefs (eglot--TextDocumentPositionParams)
                   (symbol-name (symbol-at-point))))))
 
+(defun eglot--find-by-kind (prompt kind)
+  "Find the xrefs of KIND for the identifier at point, PROMPT asking for one.
+Through `xref-find-by-kind' where xref has it.  The xref 1.7.0 of Emacs
+31, which lacks it and `xref-read-identifier', shows what the backend's
+`xref-backend-xrefs-by-kind' returns through `xref-show-xrefs'; it asks
+for the identifier only with a prefix argument or none at point, as
+Emacs 31's finders did, whatever `xref-prompt-for-identifier' says."
+  (if (fboundp 'xref-find-by-kind)
+      (with-no-warnings
+        (xref-find-by-kind (xref-read-identifier prompt kind) kind))
+    (let* ((id (let ((xref-prompt-for-identifier nil))
+                 (with-no-warnings (xref--read-identifier (concat prompt ": ")))))
+           (buffer (current-buffer))
+           (position (point))
+           (backend (xref-find-backend)))
+      (xref-show-xrefs
+       (lambda ()
+         (save-excursion
+           (when (buffer-live-p buffer)
+             (set-buffer buffer)
+             (ignore-errors (goto-char position)))
+           (or (xref-backend-xrefs-by-kind backend id kind)
+               (user-error "No %s found for: %s" kind id))))
+       nil))))
+
 (defmacro eglot--deffinder (name kind blurb)
   `(defun ,name ()
      ,(format "Find LSP %s of symbol at point.  With prefix arg, prompt." blurb)
      (interactive)
-     (xref-find-by-kind
-      (xref-read-identifier ,(format "Find %s of" blurb) ',kind) ',kind)))
+     (eglot--find-by-kind ,(format "Find %s of" blurb) ',kind)))
 
 (eglot--deffinder eglot-find-declaration declaration "declaration")
 (eglot--deffinder eglot-find-implementation implementation "implementation")
 (eglot--deffinder eglot-find-type-definition type-definition "type definition")
+(defalias 'eglot-find-typeDefinition #'eglot-find-type-definition
+  "Find LSP type definition of symbol at point; the name before 2026-09.")
 
 (cl-defmethod xref-backend-definitions ((_backend (eql eglot)) id)
   (eglot--lsp-xrefs-for-id id :textDocument/definition :just-def t))
@@ -5960,7 +5986,7 @@ lock machinery calls us again."
                eglot-code-actions
                eglot-find-declaration
                eglot-find-implementation
-               eglot-find-typeDefinition
+               eglot-find-type-definition
                eglot-forget-pending-continuations
                eglot-format
                eglot-format-buffer
-- 
2.56.0

