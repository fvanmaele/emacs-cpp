From c00e9c04b898d1d0d753d4512db425b0fe1cc6e7 Mon Sep 17 00:00:00 2001
From: Ferdinand Vanmaele <ferdinand-joseph.vanmaele@uni-a.de>
Date: Thu, 15 Oct 2026 18:41:03 +0200
Subject: [PATCH] Share one file watch per directory among a server's
 registrations

Each workspace/didChangeWatchedFiles registration set up its own watch
on every directory, so a server registering several times (pyright does
so three times at start) needed that many watches per directory; on
macOS every kqueue watch is a file descriptor, and eglot-max-file-watches
counted each.  With the limit reached by the first registrations, the
later ones got none and, once the first were removed, no watch was left.

A server now keeps one watch per directory, with the handlers of the
registrations that use it; a registration adds its handler to an
existing watch, and a watch goes when its last registration does.  The
count is of directories.  A watch that the system ends (its directory
deleted: kqueue reports deleted, then stopped) is forgotten, and an
invalid one replaced, so a directory created again under the same name
is watched again.  Each handler runs under condition-case, so an error
in one is warned about and does not keep the event from the others.
---
 eglot.el | 106 ++++++++++++++++++++++++++++++++++++++++++-------------
 1 file changed, 82 insertions(+), 24 deletions(-)

diff --git a/eglot.el b/eglot.el
index 5734317..6b66cab 100644
--- a/eglot.el
+++ b/eglot.el
@@ -1485,10 +1485,7 @@ PRESERVE-BUFFERS as in `eglot-shutdown', which see."
           (eglot-autoshutdown nil))
       (eglot--when-live-buffer buffer (eglot--managed-mode-off))))
   ;; Kill any expensive watches
-  (maphash (lambda (_id watch-descriptors)
-             (dolist (watch-desc watch-descriptors)
-               (file-notify-rm-watch watch-desc)))
-           (eglot--file-watches server))
+  (eglot--remove-directory-watches server)
   ;; Sever the project/server relationship for `server'
   (setf (gethash (eglot--project server) eglot--servers-by-project)
         (delq server
@@ -4862,14 +4859,53 @@ at point.  With prefix argument, prompt for ACTION-KIND."
 If this limit is reached, a warning is issued and further watches
 are not added.  Set to nil for unlimited watches.")
 
+(defvar eglot--directory-watches (make-hash-table :test #'eq :weakness 'key)
+  "Server -> hash table DIRECTORY -> (DESCRIPTOR . HANDLERS).
+One file watch per directory, shared by all of a server's registrations;
+HANDLERS is an alist (ID . FUNCTION) of the registrations using it.")
+
+(defun eglot--directory-watches (server)
+  "Return SERVER's table of watched directories."
+  (or (gethash server eglot--directory-watches)
+      (puthash server (make-hash-table :test #'equal) eglot--directory-watches)))
+
+(defun eglot--dispatch-directory-event (server key event)
+  "Pass file EVENT of SERVER's watched directory KEY to every registration on it.
+An error in one is reported and does not keep the event from the others.  A
+`stopped' event (the directory was deleted) forgets the watch, so a directory
+created again under that name gets a new one."
+  (pcase-dolist (`(,id . ,handler)
+                 (cdr (gethash key (eglot--directory-watches server))))
+    (condition-case err
+        (funcall handler event)
+      (error (eglot--warn "File watch of registration %s on %s: %s"
+                          id key (error-message-string err)))))
+  (when (eq (nth 1 event) 'stopped)
+    (eglot--forget-directory-watch server key)))
+
+(defun eglot--forget-directory-watch (server key)
+  "Stop and forget SERVER's watch of directory KEY, for every registration."
+  (let ((table (eglot--directory-watches server)))
+    (when-let* ((entry (gethash key table)))
+      (ignore-errors (file-notify-rm-watch (car entry)))
+      (pcase-dolist (`(,id . ,_) (cdr entry))
+        (setf (gethash id (eglot--file-watches server))
+              (delete key (gethash id (eglot--file-watches server)))))
+      (remhash key table))))
+
+(defun eglot--remove-directory-watches (server)
+  "Stop every file watch of SERVER."
+  (maphash (lambda (_dir entry) (file-notify-rm-watch (car entry)))
+           (eglot--directory-watches server))
+  (remhash server eglot--directory-watches))
+
 (defun eglot--count-file-watches ()
   "Count total file watches across all Eglot servers."
   (let ((count 0))
     (maphash (lambda (_proj servers)
                (dolist (server servers)
-                 (maphash (lambda (_id descs)
-                            (cl-incf count (length descs)))
-                          (eglot--file-watches server))))
+                 (cl-incf count (hash-table-count
+                                 (eglot--directory-watches server)))))
              eglot--servers-by-project)
     count))
 
@@ -4919,22 +4955,38 @@ happens to be inside or matching the project root."
              (handle-event `(,desc deleted ,file))
              (handle-event `(,desc created ,file1))))))
        (add-watch (subdir)
-         (cond ((or full (not (file-readable-p subdir))))
-               ((and eglot-max-file-watches
-                     (>= watch-count eglot-max-file-watches))
-                (setq full t)
-                (eglot--warn "Reached `eglot-max-file-watches' limit of %d, \
+         (let* ((table (eglot--directory-watches server))
+                (key (directory-file-name subdir))
+                (entry (gethash key table)))
+           ;; A watch the system ended (its directory deleted) is replaced.
+           (when (and entry (not (file-notify-valid-p (car entry))))
+             (eglot--forget-directory-watch server key)
+             (setq entry nil))
+           (cond ((or full (not (file-readable-p subdir))))
+                 (entry
+                  ;; Watched already for another registration: share it.
+                  (unless (assoc id (cdr entry))
+                    (push (cons id #'handle-event) (cdr entry))
+                    (push key (gethash id (eglot--file-watches server)))))
+                 ((and eglot-max-file-watches
+                       (>= watch-count eglot-max-file-watches))
+                  (setq full t)
+                  (eglot--warn "Reached `eglot-max-file-watches' limit of %d, \
 not watching some directories" eglot-max-file-watches))
-               (t
-                (condition-case err
-                    (progn
-                      (push (file-notify-add-watch subdir '(change) #'handle-event)
-                            (gethash id (eglot--file-watches server)))
-                      (cl-incf watch-count))
-                  (file-notify-error
-                   (setq full t)
-                   (eglot--warn "Cannot watch %s: %s, not watching some directories"
-                                subdir (error-message-string err))))))))
+                 (t
+                  (condition-case err
+                      (let ((desc (file-notify-add-watch
+                                   subdir '(change)
+                                   (lambda (event)
+                                     (eglot--dispatch-directory-event
+                                      server key event)))))
+                        (puthash key (list desc (cons id #'handle-event)) table)
+                        (push key (gethash id (eglot--file-watches server)))
+                        (cl-incf watch-count))
+                    (file-notify-error
+                     (setq full t)
+                     (eglot--warn "Cannot watch %s: %s, not watching some directories"
+                                  subdir (error-message-string err)))))))))
     (let ((subdirs (if (or (null dir) in-root)
                        (subdirs-using-project)
                      (condition-case _ (subdirs-using-find)
@@ -4985,8 +5037,14 @@ not watching some directories" eglot-max-file-watches))
 (cl-defmethod eglot-unregister-capability
   (server (_method (eql workspace/didChangeWatchedFiles)) id)
   "Handle dynamic unregistration of workspace/didChangeWatchedFiles."
-  (dolist (watch-desc (gethash id (eglot--file-watches server)))
-    (file-notify-rm-watch watch-desc))
+  (let ((table (eglot--directory-watches server)))
+    (dolist (key (gethash id (eglot--file-watches server)))
+      (when-let* ((entry (gethash key table)))
+        (setcdr entry (assoc-delete-all id (cdr entry)))
+        ;; The last registration using this directory: stop watching it.
+        (unless (cdr entry)
+          (file-notify-rm-watch (car entry))
+          (remhash key table)))))
   (remhash id (eglot--file-watches server))
   (list t "OK"))
 
