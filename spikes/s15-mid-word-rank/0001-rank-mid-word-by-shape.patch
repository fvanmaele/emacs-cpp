+// S15 spike: the place of a workspace-symbol match when mid-word matches are
+// asked for.  A fuzzy match whose query appears contiguously from a word start
+// of the identifier (before template arguments, without `~`) keeps its fuzzy
+// score and is High.  A scattered fuzzy match and a mid-word match are Low,
+// scored by the share of the identifier the query covers, doubled when the
+// match ends a word segment (a scattered match's fuzzy score if higher).
+struct MiddleRank {
+  float Score;
+  bool High;
+};
+std::optional<MiddleRank> middleRank(llvm::StringRef Word, llvm::StringRef Query,
+                                     std::optional<float> Fuzzy,
+                                     unsigned MiddleMatch);
+
 class FuzzyMatcher {
 public:
   // Characters beyond MaxPat are ignored.
