diff --git a/clang-tools-extra/clangd/FuzzyMatch.cpp b/clang-tools-extra/clangd/FuzzyMatch.cpp
index 2df9395..686905c 100644
--- a/clang-tools-extra/clangd/FuzzyMatch.cpp
+++ b/clang-tools-extra/clangd/FuzzyMatch.cpp
@@ -86,6 +86,37 @@ FuzzyMatcher::FuzzyMatcher(llvm::StringRef Pattern)
                               llvm::MutableArrayRef(PatRole, PatN));
 }
 
+std::optional<MiddleRank> middleRank(llvm::StringRef Word, llvm::StringRef Query,
+                                     std::optional<float> Fuzzy,
+                                     unsigned MiddleMatch) {
+  llvm::StringRef Ident = Word.take_until([](char C) { return C == '<'; });
+  Ident.consume_front("~");
+  if (Ident.empty() || Query.empty()) {
+    if (Fuzzy)
+      return MiddleRank{*Fuzzy, true};
+    return std::nullopt;
+  }
+  llvm::SmallVector<CharRole, 64> Roles(Ident.size());
+  calculateRoles(Ident, Roles);
+  std::string LowIdent = Ident.lower(), LowQuery = Query.lower();
+  float Cover = 0;
+  for (size_t Pos = LowIdent.find(LowQuery); Pos != std::string::npos;
+       Pos = LowIdent.find(LowQuery, Pos + 1)) {
+    if (Fuzzy && Roles[Pos] == Head)
+      return MiddleRank{*Fuzzy, true};
+    size_t End = Pos + Query.size();
+    float C = float(Query.size()) / Ident.size();
+    if (End == Ident.size() || Roles[End] != Tail)
+      C *= 2;
+    Cover = std::max(Cover, C);
+  }
+  if (Fuzzy)
+    return MiddleRank{std::max(Cover, *Fuzzy), false};
+  if (Cover > 0 && Query.size() >= MiddleMatch)
+    return MiddleRank{Cover, false};
+  return std::nullopt;
+}
+
 std::optional<float> FuzzyMatcher::match(llvm::StringRef Word) {
   if (!(WordContainsPattern = init(Word)))
     return std::nullopt;
