;;; vc-cost.el --- per-git-command cost of VC refresh and diff-hl, quiet vs after checkout  -*- lexical-binding: t -*-
;; Spike code (S20 follow-up, O-78), never promoted. 50 changed files of the generated
;; repository (on branch a), diff-hl-mode on:
;;   S20_REPO=$TMPDIR/s20-repo DIFFHL=$PWD/lib/diff-hl emacs -Q --batch \
;;     -l spikes/s20-fswatch-reverter/vc-cost.el </dev/null
(require 'vc-git)
(add-to-list 'load-path (getenv "DIFFHL"))
(require 'diff-hl)
(defvar cost-log nil "Entries (PHASE CMD SECONDS).")
(defvar cost-phase nil)
(defun cost--around (fn program &rest args)
  (let ((start (float-time)))
    (prog1 (apply fn program args)
      (when (and cost-phase (equal program "git"))
        (push (list cost-phase
                    (car (seq-drop-while (lambda (a) (or (not (stringp a)) (string-prefix-p "-" a)))
                                         (nthcdr 3 args)))
                    (- (float-time) start))
              cost-log)))))
(advice-add 'call-process :around #'cost--around)
(advice-add 'process-file :around #'cost--around)
(defun cost--git (&rest args)
  (apply #'call-process "git" nil nil nil "-C" (getenv "S20_REPO") args))
(defun cost--timed (phase fn buffers)
  (setq cost-phase phase)
  (let (times)
    (dolist (b buffers)
      (with-current-buffer b
        (let ((start (float-time)))
          (funcall fn)
          (push (- (float-time) start) times))))
    (setq cost-phase nil)
    (setq times (sort times #'<))
    (message "%-22s n %d: median %.3f max %.3f total %.2f s" phase (length times)
             (nth (/ (length times) 2) times) (car (last times)) (apply #'+ times))))
(defun cost--report (phase)
  (let ((by (make-hash-table :test #'equal)))
    (dolist (e cost-log)
      (when (eq (nth 0 e) phase)
        (push (nth 2 e) (gethash (nth 1 e) by))))
    (maphash (lambda (cmd ts)
               (message "  %-22s %-14s calls %4d, median %.4f, max %.4f s" phase cmd (length ts)
                        (nth (/ (length ts) 2) (sort ts #'<)) (apply #'max ts)))
             by)))
(let* ((repo (getenv "S20_REPO"))
       (changed (with-temp-buffer
                  (call-process "git" nil t nil "-C" repo "diff" "--name-only" "a" "b")
                  (split-string (buffer-string) "\n" t)))
       (buffers (mapcar (lambda (f) (find-file-noselect (expand-file-name f repo)))
                        (seq-take changed 50))))
  (dolist (b buffers) (with-current-buffer b (diff-hl-mode 1)))
  (cost--timed 'quiet-vc #'vc-refresh-state buffers)
  (cost--timed 'quiet-revert (lambda () (revert-buffer t t t)) buffers)
  (cost--git "checkout" "-q" "b")
  (cost--timed 'checkout-revert (lambda () (revert-buffer t t t)) buffers)
  (cost--timed 'checkout-vc #'vc-refresh-state buffers)
  (cost--timed 'later-vc #'vc-refresh-state buffers)
  (cost--git "checkout" "-q" "a")
  (dolist (b buffers) (with-current-buffer b (diff-hl-mode -1)))
  (cost--timed 'nodiffhl-revert (lambda () (revert-buffer t t t)) buffers)
  (dolist (p '(quiet-vc quiet-revert checkout-revert checkout-vc later-vc nodiffhl-revert))
    (cost--report p)))
