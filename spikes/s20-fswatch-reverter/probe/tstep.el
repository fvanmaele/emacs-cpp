;;; tstep.el --- live Emacs: do self-arming timer steps leave gaps for input?  -*- lexical-binding: t; -*-
;; Spike code, never promoted (S20, 0120).
(defvar ts-out (getenv "TS_OUT"))
(defvar ts-events nil "(TIME . KIND), newest first.")
(defvar ts-steps 0)
(defun ts-log (kind) (push (cons (float-time) kind) ts-events))
(defun ts-step ()
  (ts-log 'step-start)
  (let ((s (float-time))) (while (< (- (float-time) s) 0.05)))
  (ts-log 'step-end)
  (if (< (cl-incf ts-steps) 20)
      (run-with-timer 0.01 nil #'ts-step)
    (run-with-timer 0.5 nil #'ts-finish)))
(defun ts-finish ()
  (let ((ev (reverse ts-events)) (t0 nil) (in-gap (list 0 0)) gaps lines)
    ;; per gap between a step-end and the next step-start: process outputs, commands
    (let (last-end out cmd)
      (dolist (e ev)
        (pcase (cdr e)
          ('step-end (setq last-end (car e) out 0 cmd 0))
          ('step-start (when last-end
                         (push (list (* 1000 (- (car e) last-end)) out cmd) gaps)
                         (setq last-end nil)))
          ('output (when last-end (cl-incf out)))
          ('command (when last-end (cl-incf cmd))))))
    (setq gaps (nreverse gaps))
    (let* ((first (car (cl-find 'step-start ev :key #'cdr)))
           (last (car (cl-find 'step-end ev :key #'cdr :from-end t)))
           (cmds (mapcar #'car (cl-remove-if-not (lambda (e) (eq (cdr e) 'command)) ev))))
      (push (format "commands relative to the first step: first %.0f ms, last %.0f ms; steps end %.0f ms; commands inside a step 0 by construction"
                    (* 1000 (- (car cmds) first)) (* 1000 (- (car (last cmds)) first)) (* 1000 (- last first)))
            lines))
    (push (format "steps %d; gaps %d: ms min %.1f max %.1f; gaps with output %d, with a command %d; commands in all %d; window-system %s"
                  ts-steps (length gaps)
                  (apply #'min (mapcar #'car gaps)) (apply #'max (mapcar #'car gaps))
                  (cl-count-if (lambda (g) (> (nth 1 g) 0)) gaps)
                  (cl-count-if (lambda (g) (> (nth 2 g) 0)) gaps)
                  (cl-count 'command ev :key #'cdr) window-system)
          lines)
    (dolist (g gaps) (push (format "  gap %.1f ms, outputs %d, commands %d" (nth 0 g) (nth 1 g) (nth 2 g)) lines))
    (write-region (concat (string-join (nreverse lines) "\n") "\n") nil ts-out nil 'silent)
    (kill-emacs 0)))
(add-hook 'post-command-hook (lambda () (ts-log 'command)))
(make-process :name "ticker" :command (list "sh" (expand-file-name "ticker.sh" (file-name-directory load-file-name)))
              :filter (lambda (_p _o) (ts-log 'output)))
;; Start steps when the typing starts (1.2 s in).
(run-with-timer (string-to-number (or (getenv "TS_START") "0.4")) nil #'ts-step)
(run-with-timer 15 nil (lambda () (write-region "TIMEOUT\n" nil ts-out nil 'silent) (kill-emacs 1)))
