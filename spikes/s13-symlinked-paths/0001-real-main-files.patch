+// S13 spike: name each main file by its directory's real path plus its own name,
+// the spelling getCanonicalPath() gives the symbol collector.  The database's
+// spelling (a symlink above the file) would name the main file one way in the
+// include graph and another in its symbols, and update() would drop the latter.
+// One real-path lookup per distinct directory.
+std::vector<std::string> realMainFiles(std::vector<std::string> Files,
+                                       llvm::vfs::FileSystem &FS) {
+  llvm::StringMap<std::string> RealDirs;
+  size_t Renamed = 0;
+  for (std::string &File : Files) {
+    llvm::StringRef Dir = llvm::sys::path::parent_path(File);
+    auto [It, Inserted] = RealDirs.try_emplace(Dir);
+    if (Inserted) {
+      llvm::SmallString<256> Real;
+      if (auto EC = FS.getRealPath(Dir, Real)) {
+        elog("Background-index: no real path for {0}: {1}", Dir, EC.message());
+        It->second = Dir.str();
+      } else {
+        It->second = Real.str().str();
+      }
+    }
+    if (It->second == Dir)
+      continue;
+    llvm::SmallString<256> Path(It->second);
+    llvm::sys::path::append(Path, llvm::sys::path::filename(File));
+    File = Path.str().str();
+    ++Renamed;
+  }
+  if (Renamed)
+    log("Background-index: {0} of {1} main files named by their real path "
+        "({2} directories)",
+        Renamed, Files.size(), RealDirs.size());
+  return Files;
+}
+
