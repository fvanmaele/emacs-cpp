+// S14 spike: each segment of the query's scope fuzzy-matches a segment of the
+// symbol's scope, in order, so geom:: matches GeometryInfo::.
+bool fuzzyScopeMatch(llvm::StringRef Scope, llvm::StringRef Query) {
+  llvm::SmallVector<llvm::StringRef> Want, Have;
+  Query.split(Want, "::", -1, /*KeepEmpty=*/false);
+  Scope.split(Have, "::", -1, /*KeepEmpty=*/false);
+  size_t I = 0;
+  for (llvm::StringRef Segment : Have) {
+    if (I == Want.size())
+      break;
+    if (FuzzyMatcher(Want[I]).match(Segment))
+      ++I;
+  }
+  return I == Want.size();
+}
