+
+void generateIdentifierGapTrigrams(llvm::StringRef Identifier,
+                                   llvm::ArrayRef<Trigram> Ordinary,
+                                   std::vector<Trigram> &Out) {
+  Out.clear();
+  llvm::StringRef Id = Identifier.take_until([](char C) { return C == '<'; });
+  Id.consume_front("~");
+  std::string Low = Id.lower();
+  for (size_t Begin = 0; Begin < Low.size();) {
+    if (!isWordChar(Low[Begin])) {
+      ++Begin;
+      continue;
+    }
+    size_t End = Begin;
+    while (End < Low.size() && isWordChar(Low[End]))
+      ++End;
+    for (size_t I = Begin; I + 2 < End; ++I)
+      for (size_t J = I + 1; J + 1 < End; ++J)
+        for (size_t K = J + 1; K < End; ++K)
+          Out.push_back(Trigram(Low[I], Low[J], Low[K]));
+    Begin = End;
+  }
+  if (Out.empty())
+    return;
+  llvm::sort(Out);
+  Out.erase(llvm::unique(Out), Out.end());
+  llvm::SmallVector<Trigram, 64> Known(Ordinary.begin(), Ordinary.end());
+  llvm::sort(Known);
+  llvm::erase_if(Out, [&](Trigram T) {
+    return std::binary_search(Known.begin(), Known.end(), T);
+  });
+}
