+std::optional<float> gapMatch(llvm::StringRef Word, llvm::StringRef Query) {
+  llvm::StringRef Identifier =
+      Word.take_until([](char C) { return C == '<'; });
+  Identifier.consume_front("~");
+  if (Query.empty() || Query.size() > Identifier.size())
+    return std::nullopt;
+  auto IsWordChar = [](char C) {
+    return llvm::isAlnum(C) || static_cast<unsigned char>(C) >= 128;
+  };
+  size_t Best = 0;
+  for (size_t Start = 0; Start + Query.size() <= Identifier.size(); ++Start) {
+    if (lower(Identifier[Start]) != lower(Query[0]))
+      continue;
+    // From this start the leftmost fit of the rest is the shortest.
+    size_t At = Start;
+    bool Fits = true;
+    for (size_t Q = 1; Q < Query.size() && Fits; ++Q) {
+      size_t Next = At + 1;
+      while (Next < Identifier.size() &&
+             lower(Identifier[Next]) != lower(Query[Q]) &&
+             IsWordChar(Identifier[Next]))
+        ++Next;
+      Fits = Next < Identifier.size() &&
+             lower(Identifier[Next]) == lower(Query[Q]);
+      At = Next;
+    }
+    if (Fits && (!Best || At - Start + 1 < Best))
+      Best = At - Start + 1;
+  }
+  if (!Best)
+    return std::nullopt;
+  return float(Query.size()) / Best;
+}
